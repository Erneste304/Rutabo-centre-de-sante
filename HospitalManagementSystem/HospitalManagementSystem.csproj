    <EmbeddedResource Remove="HospitalManagementSystem.Blazor\**;HospitalManagementSystem.API\**;HospitalManagementSystem.Core\**;HospitalManagementSystem.Data\**;HospitalManagementSystem.Console\**;HospitalManagementSystem.Tests\**" />
    <None Remove="HospitalManagementSystem.Blazor\**;HospitalManagementSystem.API\**;HospitalManagementSystem.Core\**;HospitalManagementSystem.Data\**;HospitalManagementSystem.Console\**;HospitalManagementSystem.Tests\**" />
