@page "/appointments"
@using HospitalManagementSystem.Blazor.Models.DTOs
@using HospitalManagementSystem.Blazor.Services
@inject AppointmentService AppointmentService
@inject NavigationManager Navigation

<div class="appointments-page animate-in">
    <div class="container-fluid py-4">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <button class="btn btn-link text-muted p-0 mb-2" @onclick='() => Navigation.NavigateTo("/")'>
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </button>
                <h1 class="display-5 font-weight-bold color-primary">Appointments & Scheduling</h1>
                <p class="text-secondary">Track patient visits, manage doctor availability, and monitor the waiting room.</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline-primary btn-round px-4 mr-2"><i class="fas fa-calendar-alt mr-2"></i> Calendar View</button>
                <button class="btn btn-primary btn-round px-4 shadow-sm" @onclick="OpenBookingDialog">
                    <i class="fas fa-plus mr-2"></i> Book Appointment
                </button>
            </div>
        </div>

        <!-- Quick Filters -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="premium-card p-3 d-flex align-items-center gap-3">
                    <span class="text-muted font-weight-bold mr-3">Filter by:</span>
                    <div class="status-filters d-flex gap-2">
                        @foreach (var status in _statuses)
                        {
                            <button class="btn btn-sm btn-pill @(_selectedStatus == status ? "btn-primary" : "btn-outline-secondary")" @onclick="() => FilterByStatus(status)">
                                @status
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="row">
            <div class="col-lg-12">
                <div class="premium-card p-0 overflow-hidden shadow-lg border-0">
                    <div class="table-header p-4 bg-white d-flex justify-content-between align-items-center border-bottom">
                        <h3 class="m-0 font-weight-bold">Today's Waitlist</h3>
                        <div class="search-box">
                            <input type="text" class="form-control" placeholder="Search patients..." @bind="_searchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="px-4">Time</th>
                                    <th>Patient</th>
                                    <th>Doctor</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th class="text-right px-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_isLoading)
                                {
                                    <tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                                }
                                else if (!FilteredAppointments.Any())
                                {
                                    <tr><td colspan="6" class="text-center py-5 text-muted">No appointments found for the selected filters.</td></tr>
                                }
                                else
                                {
                                    @foreach (var apt in FilteredAppointments)
                                    {
                                        <tr>
                                            <td class="px-4 font-weight-bold">@apt.AppointmentTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm mr-2">@apt.PatientName[0]</div>
                                                    <div>
                                                        <div class="font-weight-bold">@apt.PatientName</div>
                                                        <div class="text-muted extra-small">ID: #@apt.AppointmentNumber</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-primary font-weight-bold">Dr. @apt.DoctorName</div>
                                            </td>
                                            <td><span class="text-muted">@apt.AppointmentType</span></td>
                                            <td>
                                                <span class="badge @GetBadgeClass(apt.Status)">@apt.Status</span>
                                            </td>
                                            <td class="text-right px-4">
                                                <div class="dropdown d-inline-block">
                                                    <button class="btn btn-sm btn-outline-info mr-2" @onclick="() => ViewDetails(apt)">Details</button>
                                                    <select class="btn btn-sm btn-primary" @onchange="(e) => UpdateStatus(apt, e.Value.ToString())">
                                                        <option value="">Update Status</option>
                                                        <option value="Waiting">Waiting</option>
                                                        <option value="Ready">Ready</option>
                                                        <option value="Completed">Completed</option>
                                                        <option value="Cancelled">Cancelled</option>
                                                    </select>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .appointments-page { background: #f8fafc; min-height: 100vh; }
    .color-primary { color: #1e293b; }
    .btn-round { border-radius: 100px; font-weight: 600; }
    .btn-pill { border-radius: 50px; padding: 5px 20px; font-weight: 500; font-size: 0.85rem; }
    .premium-card { background: white; border-radius: 16px; padding: 25px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    .avatar-sm { width: 32px; height: 32px; background: #e2e8f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; }
    .extra-small { font-size: 0.7rem; }
    .badge { padding: 6px 12px; border-radius: 8px; font-weight: 600; }
    .bg-ready { background: #dcfce7; color: #166534; }
    .bg-waiting { background: #fef9c3; color: #854d0e; }
    .bg-scheduled { background: #e0f2fe; color: #075985; }
</style>

@code {
    private List<AppointmentModel> _appointments = new();
    private bool _isLoading = true;
    private string _searchTerm = "";
    private string _selectedStatus = "All";
    private readonly string[] _statuses = { "All", "Scheduled", "Waiting", "Ready", "Completed", "Cancelled" };

    private IEnumerable<AppointmentModel> FilteredAppointments => 
        _appointments.Where(a => (_selectedStatus == "All" || a.Status == _selectedStatus) && 
                                 (string.IsNullOrEmpty(_searchTerm) || a.PatientName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        _isLoading = true;
        _appointments = await AppointmentService.GetAppointmentsAsync();
        _isLoading = false;
    }

    private void FilterByStatus(string status) => _selectedStatus = status;

    private string GetBadgeClass(string status) => status switch {
        "Ready" => "bg-ready",
        "Waiting" => "bg-waiting",
        "Scheduled" => "bg-scheduled",
        "Completed" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };

    private async Task UpdateStatus(AppointmentModel apt, string newStatus)
    {
        if (string.IsNullOrEmpty(newStatus)) return;
        var success = await AppointmentService.UpdateStatusAsync(apt.AppointmentId, newStatus);
        if (success) await LoadAppointments();
    }

    private void ViewDetails(AppointmentModel apt) { }
    private void OpenBookingDialog() { }
}
