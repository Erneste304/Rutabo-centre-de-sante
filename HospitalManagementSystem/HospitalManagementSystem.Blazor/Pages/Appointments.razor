@page "/appointments"
@inject NavigationManager Navigation
@inject AppointmentService AppointmentService
@inject IJSRuntime JSRuntime

<PageTitle>Appointments - Hospital Management System</PageTitle>

<div class="appointments-container">
    <div class="page-header">
        <div>
            <h1>Appointments</h1>
            <p>Schedule and manage patient appointments</p>
        </div>
        <a href="/appointments/new" class="btn btn-primary">+ Schedule Appointment</a>
    </div>

    <!-- Stats row -->
    <div class="billing-stats">
        <div class="stat-card">
            <h3>Total Today</h3>
            <p class="stat-value">@appointments.Count</p>
        </div>
        <div class="stat-card">
            <h3>Scheduled</h3>
            <p class="stat-value">@appointments.Count(a => a.Status == "Scheduled")</p>
        </div>
        <div class="stat-card">
            <h3>Completed</h3>
            <p class="stat-value">@appointments.Count(a => a.Status == "Completed")</p>
        </div>
        <div class="stat-card">
            <h3>Cancelled</h3>
            <p class="stat-value">@appointments.Count(a => a.Status == "Cancelled")</p>
        </div>
    </div>

    <div class="appointments-grid">
        <div class="card">
            <div class="card-header">
                <h2>Appointments</h2>
                <div class="filter-controls">
                    <input type="text" placeholder="Search..." @bind="searchQuery" @oninput="OnSearchChanged" class="search-input" style="width:180px" />
                    <select @bind="selectedStatus" @bind:event="oninput" class="filter-select">
                        <option value="">All Status</option>
                        <option value="Scheduled">Scheduled</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>

            <div class="card-body">
                @if (isLoading)
                {
                    <div class="loading-spinner">
                        <div class="spinner"></div>
                        <p>Loading appointments...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                else if (filteredAppointments?.Count > 0)
                {
                    <div class="appointments-list">
                        @foreach (var apt in filteredAppointments)
                        {
                            <div class="appointment-card">
                                <div class="appointment-time">
                                    <div class="time-badge">
                                        <span class="time">@apt.AppointmentTime.ToString(@"hh\:mm")</span>
                                        <span class="date">@apt.AppointmentDate.ToString("MMM dd")</span>
                                    </div>
                                </div>
                                <div class="appointment-details">
                                    <h3>@apt.PatientName</h3>
                                    <p class="doctor">👨‍⚕️ @apt.DoctorName</p>
                                    <p class="reason">@apt.Reason</p>
                                    <div class="appointment-meta">
                                        <span class="badge badge-@apt.Status.ToLower().Replace(" ", "-")">@apt.Status</span>
                                        <span class="room">@apt.AppointmentType</span>
                                    </div>
                                </div>
                                <div class="appointment-actions">
                                    <button class="btn-icon" title="Edit" @onclick="() => EditAppointment(apt.AppointmentId)">✏️</button>
                                    @if (apt.Status == "Scheduled" || apt.Status == "Confirmed")
                                    {
                                        <button class="btn-icon" title="Complete" @onclick="() => UpdateStatus(apt.AppointmentId, \"Completed\")">✓</button>
                                        <button class="btn-icon btn-danger" title="Cancel" @onclick="() => UpdateStatus(apt.AppointmentId, \"Cancelled\")">✕</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <p>No appointments found</p>
                        <a href="/appointments/new" class="btn btn-primary mt-2">Schedule First Appointment</a>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h2>Calendar View</h2>
            </div>
            <div class="card-body">
                <div class="mini-calendar">
                    <div class="calendar-header">
                        <button class="btn-nav" @onclick="PrevMonth">←</button>
                        <span class="month-year">@currentMonth.ToString("MMMM yyyy")</span>
                        <button class="btn-nav" @onclick="NextMonth">→</button>
                    </div>
                    <div class="calendar-grid">
                        <div class="day-header">Sun</div>
                        <div class="day-header">Mon</div>
                        <div class="day-header">Tue</div>
                        <div class="day-header">Wed</div>
                        <div class="day-header">Thu</div>
                        <div class="day-header">Fri</div>
                        <div class="day-header">Sat</div>

                        @{
                            var firstDay = new DateTime(currentMonth.Year, currentMonth.Month, 1);
                            var startOffset = (int)firstDay.DayOfWeek;
                            var daysInMonth = DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);
                            for (int i = 0; i < startOffset; i++)
                            {
                                <div class="calendar-day empty"></div>
                            }
                            for (int day = 1; day <= daysInMonth; day++)
                            {
                                var d = day;
                                var date = new DateTime(currentMonth.Year, currentMonth.Month, d);
                                var hasApt = appointments.Any(a => a.AppointmentDate.Date == date.Date);
                                var isToday = date.Date == DateTime.Today;
                                <div class="calendar-day @(isToday ? "today" : "") @(hasApt ? "has-appointment" : "")"
                                     title="@(hasApt ? $"{appointments.Count(a => a.AppointmentDate.Date == date.Date)} appointment(s)" : "")">
                                    @d
                                    @if (hasApt)
                                    {
                                        <span class="apt-dot"></span>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<AppointmentModel> appointments = new();
    private List<AppointmentModel> filteredAppointments = new();
    private string searchQuery = "";
    private string selectedStatus = "";
    private bool isLoading = true;
    private string? errorMessage;
    private DateTime currentMonth = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            appointments = await AppointmentService.GetAppointmentsAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load appointments: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        filteredAppointments = appointments
            .Where(a => string.IsNullOrEmpty(searchQuery) ||
                   a.PatientName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                   a.DoctorName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .Where(a => string.IsNullOrEmpty(selectedStatus) ||
                   a.Status.Equals(selectedStatus, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(a => a.AppointmentDate)
            .ThenBy(a => a.AppointmentTime)
            .ToList();
    }

    private void EditAppointment(int id) => Navigation.NavigateTo($"/appointments/{id}/edit");

    private async Task UpdateStatus(int id, string status)
    {
        var success = await AppointmentService.UpdateStatusAsync(id, status);
        if (success)
        {
            var apt = appointments.FirstOrDefault(a => a.AppointmentId == id);
            if (apt != null)
            {
                apt.Status = status;
                ApplyFilters();
            }
        }
    }

    private void PrevMonth() => currentMonth = currentMonth.AddMonths(-1);
    private void NextMonth() => currentMonth = currentMonth.AddMonths(1);
}
