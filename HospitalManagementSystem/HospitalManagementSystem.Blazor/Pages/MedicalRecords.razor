@page "/medical-records"
@inject NavigationManager Navigation
@using HospitalManagementSystem.Blazor.Services
@inject IJSRuntime JSRuntime

<PageTitle>Medical Records – Rutabo HMS</PageTitle>

<div class="animate-in">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1><i class="fas fa-file-medical" style="color:var(--brand-primary);margin-right:10px;font-size:1.4rem;"></i>Medical Records</h1>
            <p>View, manage, and track patient medical history</p>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-secondary" @onclick="LoadRecords">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
            <a href="/medical-records/new" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Record
            </a>
        </div>
    </div>

    <!-- Main Card -->
    <div class="card">
        <!-- Toolbar -->
        <div class="card-header">
            <div>
                <div class="card-title">Patient Records Timeline</div>
            </div>
            <div class="d-flex gap-2 items-center flex-wrap">
                <div class="search-wrapper" style="min-width:280px;">
                    <span class="search-icon"><i class="fas fa-search"></i></span>
                    <input type="text" placeholder="Search patient, doctor, or keyword..."
                           @bind="searchQuery" @oninput="OnSearchChanged"
                           class="form-control" />
                </div>
                <select @bind="selectedRecordType" @bind:event="oninput" @onchange="OnFilterChanged" class="form-control" style="width:160px;">
                    <option value="">All Types</option>
                    <option value="Diagnosis">Diagnosis</option>
                    <option value="Lab Test">Lab Test</option>
                    <option value="Prescription">Prescription</option>
                    <option value="Surgery">Surgery</option>
                    <option value="Notes">Clinical Notes</option>
                </select>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <span>Loading medical records...</span>
            </div>
        }
        else if (filteredRecords?.Count > 0)
        {
            <div class="card-body">
                <div class="records-timeline">
                    @foreach (var record in filteredRecords)
                    {
                        var (iconClass, badgeClass) = record.RecordType switch
                        {
                            "Diagnosis" => ("fa-stethoscope", "badge-primary"),
                            "Lab Test" => ("fa-vial", "badge-info"),
                            "Prescription" => ("fa-pills", "badge-purple"),
                            "Surgery" => ("fa-scalpel", "badge-danger"),
                            _ => ("fa-file-alt", "badge-grey")
                        };

                        <div class="timeline-item">
                            <div class="timeline-marker">
                                <div class="timeline-icon @badgeClass">
                                    <i class="fas @iconClass"></i>
                                </div>
                            </div>
                            <div class="timeline-content card">
                                <div class="record-header border-bottom p-3 d-flex justify-between items-center">
                                    <div class="d-flex items-center gap-3">
                                        <div class="avatar avatar-md">
                                            @(record.PatientName.Length > 0 ? record.PatientName[0].ToString().ToUpper() : "?")
                                        </div>
                                        <div>
                                            <h3 class="mb-0 font-heading" style="font-size:1.1rem;font-weight:700;">@record.PatientName</h3>
                                            <span class="text-muted-color" style="font-size:0.8rem;">
                                                <i class="far fa-clock"></i> @record.RecordDate.ToString("MMM dd, yyyy HH:mm")
                                            </span>
                                        </div>
                                    </div>
                                    <span class="badge @badgeClass">@record.RecordType</span>
                                </div>
                                <div class="record-details p-3">
                                    <p class="mb-2" style="font-size:0.9rem;">
                                        <strong>Attending Doctor:</strong> <span class="text-secondary-color">@record.DoctorName</span>
                                    </p>
                                    <div class="record-desc bg-hover p-3 rounded-md" style="font-size:0.85rem;line-height:1.6;">
                                        @record.Description
                                    </div>
                                </div>
                                <div class="record-actions border-top p-2 d-flex justify-end gap-2 bg-hover">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ViewRecord(record.Id)">
                                        <i class="fas fa-eye"></i> View Full
                                    </button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => EditRecord(record.Id)">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => DownloadRecord(record.Id)">
                                        <i class="fas fa-download"></i> PDF
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-folder-open"></i></div>
                <h3>No records found</h3>
                <p>No medical records match your criteria.</p>
                <a href="/medical-records/new" class="btn btn-primary mt-4">
                    <i class="fas fa-plus"></i> Add New Record
                </a>
            </div>
        }
    </div>
</div>

<style>
    /* Timeline styles */
    .records-timeline {
        position: relative;
        padding-left: 20px;
        margin: 10px 0;
    }
    
    .records-timeline::before {
        content: '';
        position: absolute;
        left: 36px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--surface-border);
    }
    
    .timeline-item {
        position: relative;
        padding-left: 50px;
        margin-bottom: 24px;
    }
    
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    
    .timeline-marker {
        position: absolute;
        left: 0;
        top: 15px;
        width: 34px;
        display: flex;
        justify-content: center;
        z-index: 2;
    }
    
    .timeline-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid var(--surface-card);
        color: white;
        font-size: 12px;
    }
    
    .timeline-icon.badge-primary { background: var(--brand-primary); }
    .timeline-icon.badge-info { background: var(--brand-info); }
    .timeline-icon.badge-purple { background: var(--color-admin); }
    .timeline-icon.badge-danger { background: var(--brand-danger); }
    .timeline-icon.badge-grey { background: var(--text-secondary); }
    
    .timeline-content {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .timeline-content:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-sm);
    }
</style>

@code {
    private List<MedicalRecordDto> allRecords = new();
    private List<MedicalRecordDto> filteredRecords = new();
    private string searchQuery = "";
    private string selectedRecordType = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRecords();
    }
    
    private async Task LoadRecords()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            // Mock data for UI demonstration
            await Task.Delay(400); // simulate network
            allRecords = new List<MedicalRecordDto>
            {
                new MedicalRecordDto
                {
                    Id = 1,
                    PatientName = "John Doe",
                    DoctorName = "Dr. Smith",
                    RecordDate = DateTime.Now.AddDays(-5),
                    RecordType = "Diagnosis",
                    Description = "Patient presented with elevated blood pressure (150/95). Diagnosed with Stage 1 Hypertension. Recommended DASH diet and prescribed Lisinopril 10mg daily."
                },
                new MedicalRecordDto
                {
                    Id = 2,
                    PatientName = "Jane Smith",
                    DoctorName = "Dr. Johnson",
                    RecordDate = DateTime.Now.AddDays(-3),
                    RecordType = "Lab Test",
                    Description = "Comprehensive Metabolic Panel (CMP) results reviewed. Glucose levels slightly elevated at 110 mg/dL. Other values within normal ranges. Advised follow-up in 3 months."
                },
                new MedicalRecordDto
                {
                    Id = 3,
                    PatientName = "Bob Wilson",
                    DoctorName = "Dr. Brown",
                    RecordDate = DateTime.Now.AddDays(-1),
                    RecordType = "Surgery",
                    Description = "Laparoscopic appendectomy performed successfully under general anesthesia. No complications during procedure. Patient recovering well in PACU."
                },
                new MedicalRecordDto
                {
                    Id = 4,
                    PatientName = "Alice Williams",
                    DoctorName = "Dr. Davis",
                    RecordDate = DateTime.Now.AddHours(-12),
                    RecordType = "Prescription",
                    Description = "Refilled Amoxicillin 500mg, take 1 capsule 3 times daily for 7 days for sinus infection."
                }
            };
            
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading medical records: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        ApplyFilters();
    }
    
    private void ApplyFilters()
    {
        filteredRecords = allRecords
            .Where(r => string.IsNullOrEmpty(searchQuery) ||
                        r.PatientName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        r.DoctorName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        r.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .Where(r => string.IsNullOrEmpty(selectedRecordType) ||
                        r.RecordType.Equals(selectedRecordType, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(r => r.RecordDate)
            .ToList();
    }

    private void ViewRecord(int id) => Navigation.NavigateTo($"/medical-records/{id}");
    private void EditRecord(int id) => Navigation.NavigateTo($"/medical-records/{id}/edit");
    
    private async Task DownloadRecord(int id)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"Generating PDF for record #{id}...");
    }

    public class MedicalRecordDto
    {
        public int Id { get; set; }
        public string PatientName { get; set; } = "";
        public string DoctorName { get; set; } = "";
        public DateTime RecordDate { get; set; }
        public string RecordType { get; set; } = "";
        public string Description { get; set; } = "";
    }
}
