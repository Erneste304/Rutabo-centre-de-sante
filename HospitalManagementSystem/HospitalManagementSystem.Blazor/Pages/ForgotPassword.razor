@page "/forgot-password"
@using HospitalManagementSystem.Blazor.Services
@inject AuthService AuthService

<div class="premium-card auth-card animate-in">
    <div class="login-header text-center">
        <div class="hospital-logo mb-3">
            <i class="fas fa-unlock-alt" style="color: var(--primary-gradient); font-size: 2.5rem;"></i>
            <h2 class="mt-2">Reset Password</h2>
        </div>
        <p>Enter your username to recover your account.</p>
    </div>
    
    @if (_isSuccess)
    {
        <div class="alert alert-success text-center mt-3" role="alert" style="border-radius: 12px; background-color: #d1fae5; color: #065f46; border: none;">
            <i class="fas fa-check-circle me-2"></i> If the account exists, a reset request has been sent to the administrator.
        </div>
        
        <div class="mt-4 text-center">
            <button class="btn btn-primary btn-round" @onclick="OnSwitchToLogin">
                Return to Login
            </button>
        </div>
    }
    else
    {
        <div class="login-form mt-4">
            <div class="form-group mb-4">
                <label><i class="fas fa-user mb-2"></i> Username</label>
                <input @bind="_username" @bind:event="oninput" 
                       type="text" placeholder="Enter your username" class="form-control premium-input" />
            </div>

            <button class="btn btn-primary btn-block w-100 mb-3" @onclick="HandleSubmit" disabled="@_isSubmitting" style="padding: 12px; font-weight: bold; font-size: 1.1rem; border-radius: 12px;">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>Processing Reset...</span>
                }
                else
                {
                    <i class="fas fa-paper-plane"></i>
                    <span>Send Reset Request</span>
                }
            </button>

            <div class="login-footer text-center mt-3">
                <p>Remembered your password? <br/> <a href="javascript:void(0)" @onclick="OnSwitchToLogin" style="color: #6366f1; font-weight: bold;">Login Here</a></p>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnSwitchToLogin { get; set; }
    
    private string _username = "";
    private bool _isSubmitting = false;
    private bool _isSuccess = false;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_username)) return;

        _isSubmitting = true;
        try
        {
            await AuthService.ForgotPasswordAsync(_username);
            _isSuccess = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
