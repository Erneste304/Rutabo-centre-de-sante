@page "/register"
@layout LoginLayout
@using HospitalManagementSystem.Blazor.Services
@inject AuthService AuthService

<div class="premium-card auth-card animate-in">
    <div class="login-header">
        <div class="hospital-logo">
            <i class="fas fa-hospital-alt" style="color: var(--primary-gradient)"></i>
            <h2>Create Account</h2>
        </div>
        <p>Join the Rutabo Healthcare Network</p>
    </div>
    
    <div class="login-form mt-4">
        <div class="form-group mb-3">
            <label><i class="fas fa-id-card"></i> Full Name</label>
            <input @bind="_fullName" type="text" placeholder="Dr. John Doe" class="form-control premium-input" />
        </div>

        <div class="form-group mb-3">
            <label><i class="fas fa-envelope"></i> Email Address</label>
            <input @bind="_email" type="email" placeholder="john.doe@clinic.com" class="form-control premium-input" />
        </div>
        
        <div class="form-group mb-3">
            <label><i class="fas fa-user"></i> Username</label>
            <input @bind="_username" type="text" placeholder="johndoe" class="form-control premium-input" />
        </div>
        
        <div class="form-group mb-4">
            <label><i class="fas fa-lock"></i> Password</label>
            <div class="password-container input-group">
                <input @bind="_password" type="@(_showPassword ? "text" : "password")" 
                       placeholder="Create a strong password" class="form-control premium-input" />
                <button class="btn btn-outline-secondary" type="button" @onclick="() => _showPassword = !_showPassword">
                    <i class="fas fa-eye@(_showPassword ? "-slash" : "")"></i>
                </button>
            </div>
        </div>

        <div class="form-group mb-4">
            <label>Select Your Role</label>
            <div class="user-type-buttons">
                @foreach (var userType in _userTypes)
                {
                    <button type="button" 
                            class="btn btn-sm @(userType == _selectedUserType ? "btn-primary shadow-sm" : "btn-outline-secondary")"
                            @onclick="() => _selectedUserType = userType" style="margin-right: 5px; margin-bottom: 5px;">
                        <i class="@GetUserTypeIcon(userType)"></i>
                        <span>@userType</span>
                    </button>
                }
            </div>
        </div>
        
        <button class="btn btn-primary btn-block btn-login w-100 mb-3" @onclick="HandleRegister" disabled="@_isRegistering" style="padding: 12px; font-weight: bold; font-size: 1.1rem; border-radius: 12px;">
            @if (_isRegistering)
            {
                <span class="spinner-border spinner-border-sm"></span>
                <span>Creating Account...</span>
            }
            else
            {
                <i class="fas fa-user-plus"></i>
                <span>Register Account</span>
            }
        </button>

        <div class="login-footer text-center mt-3">
            <p>Already have an account? <a href="javascript:void(0)" @onclick="OnSwitchToLogin" style="color: #6366f1; font-weight: bold;">Login Here</a></p>
        </div>
    </div>
</div>

<style>
    .auth-card {
        background: rgba(255, 255, 255, 0.95) !important;
        padding: 2.5rem !important;
    }
    .premium-input {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }
    .premium-input:focus {
        background: white;
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        outline: none;
    }
    .hospital-logo h2 {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }
</style>

@code {
    [Parameter] public EventCallback<UserModel> OnRegisterSuccess { get; set; }
    [Parameter] public EventCallback OnSwitchToLogin { get; set; }

    private string _username = "";
    private string _fullName = "";
    private string _email = "";
    private string _password = "";
    private bool _showPassword = false;
    private bool _isRegistering = false;
    private string _selectedUserType = "Patient";
    
    private readonly List<string> _userTypes = new() { "Admin", "Doctor", "Nurse", "Patient" };

    private string GetUserTypeIcon(string userType) => userType switch
    {
        "Admin" => "fas fa-user-shield",
        "Doctor" => "fas fa-user-md",
        "Nurse" => "fas fa-user-nurse",
        "Patient" => "fas fa-user-injured",
        _ => "fas fa-user"
    };

    private async Task HandleRegister()
    {
        _isRegistering = true;
        try
        {
            var success = await AuthService.RegisterAsync(_username, _fullName, _email, _password, _selectedUserType);
            if (success)
            {
                var user = await AuthService.LoginAsync(_username, _password, _selectedUserType);
                if (user != null)
                {
                    await OnRegisterSuccess.InvokeAsync(user);
                }
            }
        }
        finally
        {
            _isRegistering = false;
        }
    }
}
