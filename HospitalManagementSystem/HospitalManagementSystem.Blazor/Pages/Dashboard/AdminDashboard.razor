@namespace HospitalManagementSystem.Blazor.Pages.Dashboard
@using HospitalManagementSystem.Blazor.Services
@using HospitalManagementSystem.Blazor.Models.DTOs
@inject DashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard – Rutabo HMS</PageTitle>

<div class="animate-in">

    <!-- ── Welcome Banner ── -->
    <div class="welcome-banner">
        <div class="welcome-content">
            <div class="welcome-text">
                <p class="welcome-greeting">Good @_greeting,</p>
                <h1 class="welcome-name">@FullName</h1>
                <p class="welcome-sub">Here's your clinic overview for @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
            </div>
            <div class="welcome-actions">
                <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/billing")'>
                    <i class="fas fa-file-invoice-dollar"></i> Billing
                </button>
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/patients/new")'>
                    <i class="fas fa-plus"></i> Add Patient
                </button>
            </div>
        </div>
        <div class="welcome-deco">
            <span>🏥</span>
        </div>
    </div>

    <!-- ── Stat Cards ── -->
    <div class="stat-grid">
        <div class="stat-card" style="--stat-color:#4361ee; --stat-bg:rgba(67,97,238,0.1);">
            <div class="stat-card-header">
                <div>
                    <div class="stat-card-label">Total Patients</div>
                    <div class="stat-card-value">@(_stats?.TotalPatients.ToString("N0") ?? "—")</div>
                </div>
                <div class="stat-card-icon">
                    <i class="fas fa-user-injured"></i>
                </div>
            </div>
            <div class="stat-card-change up">
                <i class="fas fa-arrow-trend-up"></i>
                <span>+15%</span>
                <span class="change-text ml-1">vs last week</span>
            </div>
        </div>

        <div class="stat-card" style="--stat-color:#06d6a0; --stat-bg:rgba(6,214,160,0.1);">
            <div class="stat-card-header">
                <div>
                    <div class="stat-card-label">Staff on Duty</div>
                    <div class="stat-card-value">@(_stats?.TotalStaff.ToString("N0") ?? "—")</div>
                </div>
                <div class="stat-card-icon">
                    <i class="fas fa-user-md"></i>
                </div>
            </div>
            <div class="stat-card-change up">
                <i class="fas fa-arrow-trend-up"></i>
                <span>+3</span>
                <span class="change-text ml-1">since yesterday</span>
            </div>
        </div>

        <div class="stat-card" style="--stat-color:#f72585; --stat-bg:rgba(247,37,133,0.1);">
            <div class="stat-card-header">
                <div>
                    <div class="stat-card-label">Avg. Wait Time</div>
                    <div class="stat-card-value">@(_stats?.AvgWaitTime ?? 18)<small style="font-size:1rem;font-weight:600;">m</small></div>
                </div>
                <div class="stat-card-icon">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
            <div class="stat-card-change up">
                <i class="fas fa-arrow-trend-down"></i>
                <span>-12%</span>
                <span class="change-text ml-1">improvement</span>
            </div>
        </div>

        <div class="stat-card" style="--stat-color:#fb8500; --stat-bg:rgba(251,133,0,0.1);">
            <div class="stat-card-header">
                <div>
                    <div class="stat-card-label">Monthly Revenue</div>
                    <div class="stat-card-value">$@(_stats?.ClinicRevenue.ToString("N1") ?? "0")<small style="font-size:1rem;font-weight:600;">k</small></div>
                </div>
                <div class="stat-card-icon">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
            <div class="stat-card-change up">
                <i class="fas fa-arrow-trend-up"></i>
                <span>+8%</span>
                <span class="change-text ml-1">this month</span>
            </div>
        </div>
    </div>

    <!-- ── Two-column Section ── -->
    <div class="dash-grid">

        <!-- Quick Actions -->
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">Quick Actions</div>
                    <div class="card-subtitle">Frequently used operations</div>
                </div>
            </div>
            <div class="card-body">
                <div class="quick-actions-grid">
                    <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/patients/new")'>
                        <div class="qa-icon" style="background:rgba(67,97,238,0.1);color:#4361ee">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <span>New Patient</span>
                    </button>
                    <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/appointments")'>
                        <div class="qa-icon" style="background:rgba(6,214,160,0.1);color:#06d6a0">
                            <i class="fas fa-calendar-plus"></i>
                        </div>
                        <span>Schedule Appt</span>
                    </button>
                    <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/pharmacy")'>
                        <div class="qa-icon" style="background:rgba(247,37,133,0.1);color:#f72585">
                            <i class="fas fa-prescription-bottle-alt"></i>
                        </div>
                        <span>Dispense Rx</span>
                    </button>
                    <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/billing")'>
                        <div class="qa-icon" style="background:rgba(251,133,0,0.1);color:#fb8500">
                            <i class="fas fa-receipt"></i>
                        </div>
                        <span>Create Invoice</span>
                    </button>
                    <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/blood-bank")'>
                        <div class="qa-icon" style="background:rgba(239,35,60,0.1);color:#ef233c">
                            <i class="fas fa-tint"></i>
                        </div>
                        <span>Blood Bank</span>
                    </button>
                    <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/emergency")'>
                        <div class="qa-icon" style="background:rgba(114,9,183,0.1);color:#7209b7">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <span>Emergency Alert</span>
                    </button>
                    <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/rooms")'>
                        <div class="qa-icon" style="background:rgba(76,201,240,0.1);color:#4cc9f0">
                            <i class="fas fa-bed"></i>
                        </div>
                        <span>Bed Status</span>
                    </button>
                    <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/reports")'>
                        <div class="qa-icon" style="background:rgba(67,97,238,0.08);color:#4361ee">
                            <i class="fas fa-chart-bar"></i>
                        </div>
                        <span>Reports</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">Recent Activity</div>
                    <div class="card-subtitle">Latest events in the system</div>
                </div>
                <span class="badge badge-success">Live</span>
            </div>
            <div class="activity-list">
                @foreach (var a in _activities)
                {
                    <div class="activity-item">
                        <div class="activity-icon" style="background:@a.BgColor; color:@a.Color">
                            <i class="fas fa-@a.Icon"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-title">@a.Title</div>
                            <div class="activity-desc">@a.Description</div>
                        </div>
                        <div class="activity-time">@a.Time</div>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- ── Department Occupancy ── -->
    <div class="card mt-4">
        <div class="card-header">
            <div>
                <div class="card-title">Department Occupancy</div>
                <div class="card-subtitle">Current bed & room usage by department</div>
            </div>
            <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/rooms")'>
                View All <i class="fas fa-arrow-right"></i>
            </button>
        </div>
        <div class="card-body">
            <div class="dept-grid">
                @foreach (var d in _departments)
                {
                    <div class="dept-card">
                        <div class="dept-header">
                            <span class="dept-name">@d.Name</span>
                            <span class="dept-pct" style="color:@(d.Pct > 85 ? "#ef233c" : d.Pct > 60 ? "#fb8500" : "#06d6a0")">
                                @d.Pct%
                            </span>
                        </div>
                        <div class="dept-bar-bg">
                            <div class="dept-bar-fill"
                                 style="width:@d.Pct%; background:@(d.Pct > 85 ? "#ef233c" : d.Pct > 60 ? "#fb8500" : "#06d6a0")">
                            </div>
                        </div>
                        <div class="dept-stats">@d.Occupied / @d.Total beds occupied</div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<style>
    /* Welcome banner */
    .welcome-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, #1a1d2e 0%, #0f3460 60%, #16213e 100%);
        border-radius: 20px;
        padding: 28px 32px;
        margin-bottom: 24px;
        overflow: hidden;
        position: relative;
        color: white;
    }

    .welcome-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: 20px;
        flex-wrap: wrap;
    }

    .welcome-greeting {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.55);
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .welcome-name {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        color: white;
        letter-spacing: -0.5px;
        margin-bottom: 6px;
    }

    .welcome-sub {
        font-size: 0.835rem;
        color: rgba(255,255,255,0.5);
    }

    .welcome-actions {
        display: flex;
        gap: 10px;
        flex-shrink: 0;
    }

    .welcome-actions .btn-secondary {
        background: rgba(255,255,255,0.12);
        border-color: rgba(255,255,255,0.2);
        color: white;
    }
    .welcome-actions .btn-secondary:hover { background: rgba(255,255,255,0.2); }

    .welcome-deco {
        position: absolute;
        right: 28px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 80px;
        opacity: 0.1;
        pointer-events: none;
    }

    /* Dashboard two-column */
    .dash-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 20px;
    }

    /* Quick actions */
    .quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 10px;
    }

    .quick-action-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 14px 8px;
        border: 1.5px solid var(--surface-border);
        border-radius: 12px;
        background: white;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-secondary);
        font-family: 'Inter', sans-serif;
        text-align: center;
    }
    .quick-action-btn:hover {
        border-color: var(--brand-primary);
        background: var(--surface-overlay);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(67,97,238,0.12);
    }

    .qa-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    /* Activity list */
    .activity-list { padding: 4px 0; }

    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 13px 22px;
        border-bottom: 1px solid var(--surface-border);
        transition: background 0.15s ease;
    }
    .activity-item:last-child { border-bottom: none; }
    .activity-item:hover { background: var(--surface-hover); }

    .activity-icon {
        width: 36px; height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
    }

    .activity-content { flex: 1; min-width: 0; }
    .activity-title {
        font-size: 0.855rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .activity-desc {
        font-size: 0.78rem;
        color: var(--text-muted);
    }
    .activity-time {
        font-size: 0.72rem;
        color: var(--text-muted);
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* Department grid */
    .dept-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .dept-card {
        padding: 14px;
        border: 1.5px solid var(--surface-border);
        border-radius: 12px;
        background: var(--surface-hover);
    }

    .dept-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .dept-name {
        font-size: 0.835rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .dept-pct {
        font-size: 0.835rem;
        font-weight: 800;
        font-family: 'Outfit', sans-serif;
    }

    .dept-bar-bg {
        height: 6px;
        background: var(--surface-border);
        border-radius: 99px;
        overflow: hidden;
        margin-bottom: 8px;
    }

    .dept-bar-fill {
        height: 100%;
        border-radius: 99px;
        transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .dept-stats {
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    @@media (max-width: 1024px) {
        .dash-grid { grid-template-columns: 1fr; }
        .quick-actions-grid { grid-template-columns: repeat(4, 1fr); }
    }

    @@media (max-width: 600px) {
        .quick-actions-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>

@code {
    [Parameter] public string FullName { get; set; } = "";
    private DashboardStatsModel? _stats;
    private string _greeting = "morning";

    private readonly List<ActivityItem> _activities = new()
    {
        new("user-plus",   "rgba(67,97,238,0.1)","#4361ee",  "New Patient Registered",      "John Doe admitted to Ward 2",    "5m ago"),
        new("calendar-check","rgba(6,214,160,0.1)","#06d6a0","Appointment Confirmed",        "Dr. Amara – General Checkup",    "18m ago"),
        new("pills",       "rgba(247,37,133,0.1)","#f72585", "Prescription Dispensed",       "Amoxicillin 500mg – Room 14",    "32m ago"),
        new("exclamation-triangle","rgba(239,35,60,0.1)","#ef233c","Emergency Alert",        "Critical lab result – Ward 3",   "1h ago"),
        new("file-invoice-dollar","rgba(251,133,0,0.1)","#fb8500","Invoice Generated",        "Invoice #INV-2026-0892 created", "2h ago"),
    };

    private readonly List<DeptItem> _departments = new()
    {
        new("General Medicine",  24, 30, 80),
        new("Cardiology",        14, 20, 70),
        new("Pediatrics",        18, 20, 90),
        new("Surgery",            8, 15, 53),
        new("Maternity",         10, 12, 83),
        new("Emergency",          6,  8, 75),
    };

    protected override async Task OnInitializedAsync()
    {
        var hour = DateTime.Now.Hour;
        _greeting = hour < 12 ? "morning" : hour < 17 ? "afternoon" : "evening";
        _stats = await DashboardService.GetDashboardStatsAsync("Admin");
    }

    private record ActivityItem(string Icon, string BgColor, string Color, string Title, string Description, string Time);
    private record DeptItem(string Name, int Occupied, int Total, int Pct);
}
