@namespace HospitalManagementSystem.Blazor.Pages.Dashboard
@using HospitalManagementSystem.Blazor.Services
@using HospitalManagementSystem.Blazor.Models.DTOs
@inject DashboardService DashboardService
@inject AppointmentService AppointmentService
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="animate-in">

    <!-- ── Welcome Banner ── -->
    <div class="welcome-banner">
        <div class="welcome-content">
            <div class="welcome-text">
                <p class="welcome-greeting">Good @_greeting,</p>
                <h1 class="welcome-name">Dr. @FullName</h1>
                <p class="welcome-sub">Your schedule for @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
            </div>
            <div class="welcome-actions">
                <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/medical-records/new")'>
                    <i class="fas fa-file-medical"></i> Clinical Note
                </button>
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/prescriptions/new")'>
                    <i class="fas fa-prescription"></i> e-Prescribe
                </button>
            </div>
        </div>
        <div class="welcome-deco">
            <span>⚕️</span>
        </div>
    </div>

    <div class="section-grid" style="grid-template-columns: 280px 1fr;">
        <!-- Left Sidebar: Profile & Schedule -->
        <div class="d-flex flex-col gap-4">
            
            <div class="card text-center p-4">
                <div class="avatar avatar-xl mx-auto mb-3" style="background:linear-gradient(135deg,var(--brand-primary),var(--brand-info))">
                    DR
                </div>
                <h3 class="mb-1 font-heading">Dr. @FullName</h3>
                <span class="badge badge-primary mb-4">Cardiology Specialist</span>
                
                <div class="d-flex justify-center gap-4">
                    <div class="text-center">
                        <div class="fw-800" style="font-size:1.4rem;color:var(--text-primary)">@(_docStats?.Appointments ?? 12)</div>
                        <div class="text-muted-color" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.5px;">Appts</div>
                    </div>
                    <div class="text-center">
                        <div class="fw-800" style="font-size:1.4rem;color:var(--text-primary)">@(_docStats?.Surgeries ?? 4)</div>
                        <div class="text-muted-color" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.5px;">Surgeries</div>
                    </div>
                </div>
            </div>

            <div class="card h-full">
                <div class="card-header border-bottom">
                    <div class="card-title">My Schedule</div>
                </div>
                <div class="card-body p-3">
                    @if (_appointments != null && _appointments.Any())
                    {
                        <div class="d-flex flex-col gap-2">
                            @foreach (var apt in _appointments.Take(5))
                            {
                                var isActive = apt.Status == "Ready" || apt.Status == "In Progress";
                                <div class="schedule-item @(isActive ? "active" : "")">
                                    <div class="fw-700" style="font-size:0.8rem;color:var(--brand-primary)">@apt.AppointmentTime.ToString(@"hh\:mm")</div>
                                    <div class="fw-600 truncate" style="font-size:0.85rem;">@apt.PatientName</div>
                                    @if(isActive)
                                    {
                                        <span class="badge-dot" style="color:var(--brand-primary);position:absolute;right:12px;top:50%;transform:translateY(-50%)"></span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state p-4">
                            <p class="mb-0" style="font-size:0.85rem">No appointments scheduled for today.</p>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- Right Content: Waiting Room & Quick Actions -->
        <div>
            <!-- Stat Cards -->
            <div class="stat-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 24px;">
                <div class="stat-card" style="--stat-color:#4361ee; --stat-bg:rgba(67,97,238,0.1);">
                    <div class="stat-card-header">
                        <div>
                            <div class="stat-card-label">In-Patients</div>
                            <div class="stat-card-value">@(_docStats?.InPatients ?? 8)</div>
                        </div>
                        <div class="stat-card-icon"><i class="fas fa-procedures"></i></div>
                    </div>
                </div>
                <div class="stat-card" style="--stat-color:#7209b7; --stat-bg:rgba(114,9,183,0.1);">
                    <div class="stat-card-header">
                        <div>
                            <div class="stat-card-label">Yearly Patients</div>
                            <div class="stat-card-value">124</div>
                        </div>
                        <div class="stat-card-icon"><i class="fas fa-users"></i></div>
                    </div>
                </div>
                <div class="stat-card" style="--stat-color:#06d6a0; --stat-bg:rgba(6,214,160,0.1);">
                    <div class="stat-card-header">
                        <div>
                            <div class="stat-card-label">Lab Reports</div>
                            <div class="stat-card-value">@(_docStats?.LabReports ?? 14)</div>
                        </div>
                        <div class="stat-card-icon"><i class="fas fa-vial"></i></div>
                    </div>
                </div>
            </div>

            <!-- Waiting Room Table -->
            <div class="card mb-4">
                <div class="card-header border-bottom">
                    <div>
                        <div class="card-title">Patient Waiting Room</div>
                        <div class="card-subtitle">Patients currently checked in</div>
                    </div>
                    <span class="badge badge-warning">
                        @_appointments.Count(a => a.Status == "Waiting" || a.Status == "Ready") Waiting
                    </span>
                </div>
                
                <div class="table-wrapper">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Patient Name</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th style="text-align:right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_isLoading)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-6">
                                        <div class="spinner mx-auto"></div>
                                    </td>
                                </tr>
                            }
                            else if (!_appointments.Any())
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="empty-state py-6">
                                            <div class="empty-state-icon"><i class="fas fa-mug-hot"></i></div>
                                            <p class="mb-0">Waiting room is currently empty.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var apt in _appointments)
                                {
                                    <tr>
                                        <td class="fw-700 text-secondary-color" style="font-size:0.85rem">
                                            @apt.AppointmentTime.ToString(@"hh\:mm")
                                        </td>
                                        <td>
                                            <div class="d-flex items-center gap-2">
                                                <div class="avatar avatar-sm">
                                                    @(apt.PatientName.Length > 0 ? apt.PatientName[0].ToString().ToUpper() : "?")
                                                </div>
                                                <span class="fw-600">@apt.PatientName</span>
                                            </div>
                                        </td>
                                        <td class="text-muted-color" style="font-size:0.85rem">@(apt.Reason ?? "Not specified")</td>
                                        <td>
                                            <span class="badge @GetBadgeClass(apt.Status)">@apt.Status</span>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-end gap-2">
                                                @if (apt.Status == "Waiting")
                                                {
                                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => CallPatient(apt)">
                                                        <i class="fas fa-bullhorn"></i> Call
                                                    </button>
                                                }
                                                @if (apt.Status == "Ready" || apt.Status == "In Progress")
                                                {
                                                    <button class="btn btn-success btn-sm" @onclick='() => UpdateStatus(apt, "Completed")'>
                                                        <i class="fas fa-check"></i> Done
                                                    </button>
                                                }
                                                <button class="btn btn-ghost btn-icon btn-sm" title="View Chart">
                                                    <i class="fas fa-notes-medical"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quick Action Grid -->
            <div class="quick-actions-grid" style="grid-template-columns: repeat(4, 1fr);">
                <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/medical-records")'>
                    <div class="qa-icon" style="background:rgba(67,97,238,0.1);color:#4361ee">
                        <i class="fas fa-file-medical"></i>
                    </div>
                    <span>Records</span>
                </button>
                <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/pharmacy")'>
                    <div class="qa-icon" style="background:rgba(114,9,183,0.1);color:#7209b7">
                        <i class="fas fa-pills"></i>
                    </div>
                    <span>Pharmacy</span>
                </button>
                <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/lab-reports")'>
                    <div class="qa-icon" style="background:rgba(6,214,160,0.1);color:#06d6a0">
                        <i class="fas fa-flask"></i>
                    </div>
                    <span>Labs</span>
                </button>
                <button class="quick-action-btn" @onclick='() => Navigation.NavigateTo("/rooms")'>
                    <div class="qa-icon" style="background:rgba(76,201,240,0.1);color:#4cc9f0">
                        <i class="fas fa-bed"></i>
                    </div>
                    <span>Rounds</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Welcome banner reuse */
    .welcome-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, #1a1d2e 0%, #0f3460 60%, #16213e 100%);
        border-radius: 20px;
        padding: 28px 32px;
        margin-bottom: 24px;
        overflow: hidden;
        position: relative;
        color: white;
    }
    
    .welcome-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: 20px;
        flex-wrap: wrap;
    }
    
    .welcome-greeting { font-size: 0.875rem; color: rgba(255,255,255,0.55); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
    .welcome-name { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; color: white; letter-spacing: -0.5px; margin-bottom: 6px; }
    .welcome-sub { font-size: 0.835rem; color: rgba(255,255,255,0.5); }
    
    .welcome-actions { display: flex; gap: 10px; flex-shrink: 0; }
    .welcome-actions .btn-secondary { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.2); color: white; }
    .welcome-actions .btn-secondary:hover { background: rgba(255,255,255,0.2); }
    
    .welcome-deco { position: absolute; right: 28px; top: 50%; transform: translateY(-50%); font-size: 80px; opacity: 0.1; pointer-events: none; }

    /* Schedule list */
    .schedule-item {
        padding: 12px 14px;
        border-radius: var(--radius-md);
        background: var(--surface-hover);
        border: 1px solid var(--surface-border);
        border-left: 3px solid var(--surface-border);
        transition: var(--t-fast);
        display: flex;
        gap: 12px;
        align-items: center;
        position: relative;
    }
    .schedule-item.active {
        background: rgba(67,97,238,0.05);
        border-color: rgba(67,97,238,0.2);
        border-left: 3px solid var(--brand-primary);
    }
    
    /* Quick actions */
    .quick-actions-grid { display: grid; gap: 10px; }
    .quick-action-btn { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 8px; border: 1.5px solid var(--surface-border); border-radius: 12px; background: white; cursor: pointer; transition: all 0.2s ease; font-size: 0.72rem; font-weight: 600; color: var(--text-secondary); font-family: 'Inter', sans-serif; text-align: center; }
    .quick-action-btn:hover { border-color: var(--brand-primary); background: var(--surface-overlay); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(67,97,238,0.12); }
    .qa-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
</style>

@code {
    [Parameter] public string FullName { get; set; } = "";
    private DoctorStats? _docStats;
    private List<AppointmentModel> _appointments = new();
    private bool _isLoading = true;
    private string _greeting = "morning";

    protected override async Task OnInitializedAsync()
    {
        var hour = DateTime.Now.Hour;
        _greeting = hour < 12 ? "morning" : hour < 17 ? "afternoon" : "evening";

        _isLoading = true;
        var statsTask = DashboardService.GetDashboardStatsAsync("Doctor");
        
        var user = AuthService.CurrentUser;
        if (user?.DoctorId > 0)
        {
            _appointments = await AppointmentService.GetDoctorAppointmentsAsync(user.DoctorId.Value, DateTime.Today);
        }

        var stats = await statsTask;
        if (stats?.RoleStats != null)
        {
            var json = System.Text.Json.JsonSerializer.Serialize(stats.RoleStats);
            _docStats = System.Text.Json.JsonSerializer.Deserialize<DoctorStats>(json);
        }
        _isLoading = false;
    }

    private string GetBadgeClass(string status) => status switch {
        "Ready" => "badge-primary",
        "Waiting" => "badge-warning",
        "Scheduled" => "badge-info",
        "Completed" => "badge-success",
        "In Progress" => "badge-danger",
        _ => "badge-grey"
    };

    private async Task CallPatient(AppointmentModel apt)
    {
        await UpdateStatus(apt, "Ready");
    }

    private async Task UpdateStatus(AppointmentModel apt, string status)
    {
        var success = await AppointmentService.UpdateStatusAsync(apt.AppointmentId, status);
        if (success)
        {
            var user = AuthService.CurrentUser;
            if (user?.DoctorId > 0)
                _appointments = await AppointmentService.GetDoctorAppointmentsAsync(user.DoctorId.Value, DateTime.Today);
        }
    }

    private class DoctorStats
    {
        public int Appointments { get; set; }
        public int Surgeries { get; set; }
        public int InPatients { get; set; }
        public int LabReports { get; set; }
    }
}
