@page "/inventory"
@inject NavigationManager Navigation

<PageTitle>Inventory - Hospital Management System</PageTitle>

<div class="inventory-container">
    <div class="page-header">
        <div>
            <h1>Inventory Management</h1>
            <p>Track medical supplies and equipment</p>
        </div>
        <a href="/inventory/new-item" class="btn btn-primary">+ Add Item</a>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="search-bar">
                <input type="text" placeholder="Search inventory..." @bind="searchQuery" @oninput="OnSearchChanged" class="search-input" />
            </div>
            <div class="filter-controls">
                <select @bind="selectedCategory" @bind:event="oninput" class="filter-select">
                    <option value="">All Categories</option>
                    <option value="medications">Medications</option>
                    <option value="equipment">Equipment</option>
                    <option value="supplies">Supplies</option>
                </select>
            </div>
        </div>

        <div class="card-body">
            @if (isLoading)
            {
                <div class="loading-spinner">
                    <div class="spinner"></div>
                    <p>Loading inventory...</p>
                </div>
            }
            else if (items?.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item Name</th>
                                <th>Category</th>
                                <th>SKU</th>
                                <th>Current Stock</th>
                                <th>Min Level</th>
                                <th>Status</th>
                                <th>Unit Price</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Category</td>
                                    <td>@item.SKU</td>
                                    <td>@item.CurrentStock</td>
                                    <td>@item.MinimumLevel</td>
                                    <td>
                                        <span class="badge badge-@(item.CurrentStock > item.MinimumLevel ? "ok" : "low")">
                                            @(item.CurrentStock > item.MinimumLevel ? "OK" : "Low Stock")
                                        </span>
                                    </td>
                                    <td>$@item.UnitPrice.ToString("F2")</td>
                                    <td>
                                        <div class="action-buttons">
                                            <button class="btn-icon" title="View" @onclick="() => ViewItem(item.Id)">👁️</button>
                                            <button class="btn-icon" title="Edit" @onclick="() => EditItem(item.Id)">✏️</button>
                                            <button class="btn-icon" title="Reorder" @onclick="() => ReorderItem(item.Id)">📦</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <p>No inventory items found</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<InventoryItemDto> items = new();
    private string searchQuery = "";
    private string selectedCategory = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            items = new List<InventoryItemDto>
            {
                new InventoryItemDto { Id = 1, Name = "Aspirin", Category = "Medications", SKU = "ASP-001", CurrentStock = 450, MinimumLevel = 100, UnitPrice = 0.50m },
                new InventoryItemDto { Id = 2, Name = "Ibuprofen", Category = "Medications", SKU = "IBU-001", CurrentStock = 150, MinimumLevel = 200, UnitPrice = 0.75m },
                new InventoryItemDto { Id = 3, Name = "Surgical Gloves", Category = "Supplies", SKU = "GLV-001", CurrentStock = 5000, MinimumLevel = 1000, UnitPrice = 0.05m },
                new InventoryItemDto { Id = 4, Name = "Oxygen Tank", Category = "Equipment", SKU = "OXY-001", CurrentStock = 25, MinimumLevel = 10, UnitPrice = 150.00m },
                new InventoryItemDto { Id = 5, Name = "Bandages", Category = "Supplies", SKU = "BND-001", CurrentStock = 2000, MinimumLevel = 500, UnitPrice = 0.10m },
            };

            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading inventory: {ex.Message}");
            isLoading = false;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        // Apply search filter
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? "";
        // Apply filter
    }

    private void ViewItem(int id)
    {
        Navigation.NavigateTo($"/inventory/{id}");
    }

    private void EditItem(int id)
    {
        Navigation.NavigateTo($"/inventory/{id}/edit");
    }

    private void ReorderItem(int id)
    {
        Navigation.NavigateTo($"/inventory/{id}/reorder");
    }

    public class InventoryItemDto
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Category { get; set; }
        public string SKU { get; set; }
        public int CurrentStock { get; set; }
        public int MinimumLevel { get; set; }
        public decimal UnitPrice { get; set; }
    }
}
