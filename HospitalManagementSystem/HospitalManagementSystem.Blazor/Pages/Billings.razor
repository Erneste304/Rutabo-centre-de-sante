@page "/billings"
@using HospitalManagementSystem.Blazor.Models.DTOs
@using HospitalManagementSystem.Blazor.Services
@inject BillingService BillingService
@inject NavigationManager Navigation

<div class="billing-page animate-in">
    <div class="container-fluid py-4">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <button class="btn btn-link text-muted p-0 mb-2" @onclick="GoBack">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </button>
                <h1 class="display-5 font-weight-bold color-primary">Billing & Revenue Hub</h1>
                <p class="text-secondary">Manage patient invoices, process payments, and track clinic revenue.</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline-primary btn-round px-4 mr-2"><i class="fas fa-file-download mr-2"></i> Export Monthly</button>
                <button class="btn btn-primary btn-round px-4 shadow-sm" @onclick="CreateNewBill">
                    <i class="fas fa-plus mr-2"></i> Create Invoice
                </button>
            </div>
        </div>

        <!-- Quick Stats Row -->
        <div class="row mb-5">
            <div class="col-md-3">
                <div class="stats-card premium-card border-left-primary">
                    <div class="card-label">Total Outstanding</div>
                    <div class="card-value">$@(_billings.Sum(b => b.BalanceDue).ToString("N0"))</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card premium-card border-left-success">
                    <div class="card-label">Revenue This Month</div>
                    <div class="card-value">$@(_billings.Where(b => b.BillDate.Month == DateTime.Now.Month).Sum(b => b.PaidAmount).ToString("N0"))</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card premium-card border-left-warning">
                    <div class="card-label">Pending Claims</div>
                    <div class="card-value">@(_billings.Count(b => b.ClaimStatus == "Pending"))</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card premium-card border-left-info">
                    <div class="card-label">Collection Rate</div>
                    <div class="card-value">92%</div>
                </div>
            </div>
        </div>

        <!-- Main Invoice Table -->
        <div class="premium-card p-0 overflow-hidden shadow-lg border-0">
            <div class="table-header p-4 bg-white d-flex justify-content-between align-items-center border-bottom">
                <h3 class="m-0 font-weight-bold">Recent Invoices</h3>
                <div class="search-box">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-transparent border-right-0"><i class="fas fa-search"></i></span>
                        </div>
                        <input type="text" class="form-control border-left-0" placeholder="Search invoices or patients..." @bind="_searchTerm" @bind:event="oninput" />
                    </div>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4">Invoice #</th>
                            <th>Patient</th>
                            <th>Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-right px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoading)
                        {
                            <tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                        }
                        else if (!FilteredBillings.Any())
                        {
                            <tr><td colspan="6" class="text-center py-5">No invoices found matching your criteria.</td></tr>
                        }
                        else
                        {
                            @foreach (var bill in FilteredBillings)
                            {
                                <tr>
                                    <td class="px-4 font-weight-bold">@bill.BillNumber</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm mr-2">@(bill.PatientName.Length > 0 ? bill.PatientName[0] : 'P')</div>
                                            <span>@bill.PatientName</span>
                                        </div>
                                    </td>
                                    <td>@bill.BillDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="font-weight-bold">$@bill.TotalAmount.ToString("N2")</div>
                                        @if(bill.BalanceDue > 0)
                                        {
                                            <div class="text-danger small">Due: $@bill.BalanceDue.ToString("N2")</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-pill @GetStatusClass(bill.PaymentStatus)">
                                            @bill.PaymentStatus
                                        </span>
                                    </td>
                                    <td class="text-right px-4">
                                        <button class="btn btn-sm btn-outline-primary mr-2" @onclick="() => ViewInvoice(bill)">View</button>
                                        @if (bill.PaymentStatus != "Paid")
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => OpenPaymentDialog(bill)">Pay</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (_showPaymentDialog && _selectedBill != null)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header bg-primary text-white p-4">
                    <h5 class="modal-title font-weight-bold">Process Payment</h5>
                    <button type="button" class="close text-white" @onclick="() => _showPaymentDialog = false">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <div class="bill-summary mb-4 p-3 bg-light rounded">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Invoiced to:</span>
                            <span class="font-weight-bold">@_selectedBill.PatientName</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Remaining Balance:</span>
                            <span class="text-danger font-weight-bold">$@_selectedBill.BalanceDue.ToString("N2")</span>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label>Payment Amount</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">$</span>
                            </div>
                            <input type="number" class="form-control form-control-lg" @bind="_paymentAmount" />
                        </div>
                    </div>
                    
                    <div class="form-group mt-4">
                        <label>Method</label>
                        <div class="d-grid gap-2 d-flex">
                            <button class="btn flex-fill @(_paymentMethod == "Cash" ? "btn-info" : "btn-outline-info")" @onclick='() => _paymentMethod = "Cash"'><i class="fas fa-money-bill-wave mr-2"></i> Cash</button>
                            <button class="btn flex-fill @(_paymentMethod == "Card" ? "btn-info" : "btn-outline-info")" @onclick='() => _paymentMethod = "Card"'><i class="fas fa-credit-card mr-2"></i> Card</button>
                            <button class="btn flex-fill @(_paymentMethod == "Insurance" ? "btn-info" : "btn-outline-info")" @onclick='() => _paymentMethod = "Insurance"'><i class="fas fa-shield-alt mr-2"></i> Insurance</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer p-4 bg-light">
                    <button type="button" class="btn btn-secondary btn-round px-4" @onclick="() => _showPaymentDialog = false">Cancel</button>
                    <button type="button" class="btn btn-primary btn-round px-4" @onclick="SubmitPayment" disabled="@_isProcessing">
                        @if (_isProcessing) { <span class="spinner-border spinner-border-sm mr-2"></span> }
                        Confirm Payment
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .billing-page { background: #f8fafc; min-height: 100vh; font-family: 'Inter', sans-serif; }
    .color-primary { color: #1e293b; }
    .btn-round { border-radius: 100px; font-weight: 600; }
    .premium-card { background: white; border-radius: 16px; padding: 25px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); }
    .stats-card { height: 100%; border-left: 5px solid transparent; }
    .border-left-primary { border-left-color: #4f46e5; }
    .border-left-success { border-left-color: #10b981; }
    .border-left-warning { border-left-color: #f59e0b; }
    .border-left-info { border-left-color: #0ea5e9; }
    .card-label { color: #64748b; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .card-value { font-size: 1.75rem; font-weight: 800; color: #1e293b; margin-top: 5px; }
    .avatar-sm { width: 32px; height: 32px; background: #e2e8f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; color: #475569; }
    .badge-pill { padding: 6px 14px; font-weight: 600; }
    .bg-status-paid { background: #d1fae5; color: #065f46; }
    .bg-status-pending { background: #fef3c7; color: #92400e; }
    .bg-status-partial { background: #e0f2fe; color: #075985; }
    .animate-in { animation: fadeInUp 0.5s ease-out; }
    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    private List<BillingModel> _billings = new();
    private bool _isLoading = true;
    private string _searchTerm = "";
    private bool _showPaymentDialog = false;
    private BillingModel? _selectedBill;
    private decimal _paymentAmount;
    private string _paymentMethod = "Cash";
    private bool _isProcessing = false;

    private IEnumerable<BillingModel> FilteredBillings => 
        string.IsNullOrWhiteSpace(_searchTerm) 
        ? _billings 
        : _billings.Where(b => b.BillNumber.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) || 
                              b.PatientName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadBillings();
    }

    private async Task LoadBillings()
    {
        _isLoading = true;
        _billings = await BillingService.GetBillingsAsync();
        _isLoading = false;
    }

    private string GetStatusClass(string status) => status switch {
        "Paid" => "bg-status-paid",
        "Pending" => "bg-status-pending",
        "Partially Paid" => "bg-status-partial",
        _ => "badge-secondary"
    };

    private void OpenPaymentDialog(BillingModel bill)
    {
        _selectedBill = bill;
        _paymentAmount = bill.BalanceDue;
        _showPaymentDialog = true;
    }

    private async Task SubmitPayment()
    {
        if (_selectedBill == null || _paymentAmount <= 0) return;
        
        _isProcessing = true;
        var payment = new PaymentModel {
            BillId = _selectedBill.BillId,
            Amount = _paymentAmount,
            PaymentMethod = _paymentMethod,
            PaymentStatus = "Completed"
        };
        
        var success = await BillingService.ProcessPaymentAsync(_selectedBill.BillId, payment);
        if (success)
        {
            _showPaymentDialog = false;
            await LoadBillings();
        }
        _isProcessing = false;
    }

    private void ViewInvoice(BillingModel bill)
    {
        // Navigation or Modal logic for details
    }

    private void CreateNewBill() { }
    private void GoBack() => Navigation.NavigateTo("/");
}
