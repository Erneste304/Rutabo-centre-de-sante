                    <ul class="service-features">
                        <li>Blood Type Inventory</li>
                        <li>Donation Tracking</li>
                        <li>Request Management</li>
                    </ul>
                </div>

                <!-- Ambulance Service -->
                <div class="service-card">
                    <div class="service-icon">🚑</div>
                    <h3>Ambulance Service</h3>
                    <p>Manage ambulance fleet and dispatch operations</p>
                    <ul class="service-features">
                        <li>Fleet Management</li>
                        <li>Driver Information</li>
                        <li>Dispatch Tracking</li>
                    </ul>
                </div>

                <!-- Emergency Alerts -->
                <div class="service-card">
                    <div class="service-icon">🚨</div>
