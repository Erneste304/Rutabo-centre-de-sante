@page "/"
@using HospitalManagementSystem.Blazor.Services
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Hospital Management System - Home</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.CheckAuthenticationAsync();
        if (isAuthenticated)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }
}

<div class="home-container">
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Rutabo Centre de Santé</h1>
                <p class="hero-subtitle">Advanced Hospital Management System</p>
                <p class="hero-description">Streamline your healthcare operations with our comprehensive digital platform</p>
                <div class="hero-buttons">
                    <a href="/login" class="btn btn-primary btn-lg">Login</a>
                    <a href="/register" class="btn btn-outline-primary btn-lg">Register</a>
                </div>
            </div>
            <div class="hero-image">
                <div class="hero-icon">🏥</div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services-section">
        <div class="container">
            <h2 class="section-title">Our Services</h2>
            <p class="section-subtitle">Complete healthcare management solutions</p>
            
            <div class="services-grid">
                <!-- Patient Management -->
                <div class="service-card">
                    <div class="service-icon">👥</div>
                    <h3>Patient Management</h3>
                    <p>Register, track, and manage patient information with complete medical history</p>
                    <ul class="service-features">
                        <li>Patient Registration</li>
                        <li>Medical Records</li>
                        <li>Health History</li>
                    </ul>
                </div>

                <!-- Appointments -->
                <div class="service-card">
                    <div class="service-icon">📅</div>
                    <h3>Appointments</h3>
                    <p>Schedule and manage doctor appointments with automated reminders</p>
                    <ul class="service-features">
                        <li>Schedule Appointments</li>
                        <li>Doctor Availability</li>
                        <li>Appointment Tracking</li>
                    </ul>
                </div>

                <!-- Medical Records -->
                <div class="service-card">
                    <div class="service-icon">📋</div>
                    <h3>Medical Records</h3>
                    <p>Maintain comprehensive medical records with diagnoses and prescriptions</p>
                    <ul class="service-features">
                        <li>Visit History</li>
                        <li>Diagnoses</li>
                        <li>Prescriptions</li>
                    </ul>
                </div>

                <!-- Pharmacy -->
                <div class="service-card">
                    <div class="service-icon">💊</div>
                    <h3>Pharmacy</h3>
                    <p>Manage medicine inventory and prescription dispensing</p>
                    <ul class="service-features">
                        <li>Medicine Stock</li>
                        <li>Prescription Management</li>
                        <li>Dispensing Workflow</li>
                    </ul>
                </div>

                <!-- Billing -->
                <div class="service-card">
                    <div class="service-icon">💰</div>
                    <h3>Billing & Payments</h3>
                    <p>Generate invoices and track payment status with insurance integration</p>
                    <ul class="service-features">
                        <li>Invoice Generation</li>
                        <li>Payment Tracking</li>
                        <li>Insurance Claims</li>
                    </ul>
                </div>

                <!-- Room Management -->
                <div class="service-card">
                    <div class="service-icon">🏥</div>
                    <h3>Room Management</h3>
                    <p>Track room availability and bed occupancy in real-time</p>
                    <ul class="service-features">
                        <li>Room Availability</li>
                        <li>Bed Occupancy</li>
