                    <p>Manage doctors, nurses, and other healthcare staff</p>
                    <ul class="service-features">
                        <li>Staff Profiles</li>
                        <li>Department Assignment</li>
                        <li>Availability Tracking</li>
                    </ul>
                </div>

                <!-- Analytics & Reports -->
                <div class="service-card">
                    <div class="service-icon">📈</div>
                    <h3>Analytics & Reports</h3>
                    <p>Generate comprehensive reports and business intelligence</p>
                    <ul class="service-features">
                        <li>Performance Metrics</li>
                        <li>Revenue Reports</li>
                        <li>Occupancy Statistics</li>
                    </ul>
                </div>
            </div>
        </div>
