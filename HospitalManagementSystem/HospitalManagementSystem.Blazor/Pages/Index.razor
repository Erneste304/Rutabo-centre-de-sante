@page "/"
@using HospitalManagementSystem.Blazor.Services
@using HospitalManagementSystem.Blazor.Shared
@inject AuthService AuthService
@inject DashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Global Data 365 | Hospital Management Dashboard</PageTitle>

@if (_isLoading)
{
    <div class="loading-overlay">
        <div class="innovative-spinner"></div>
    </div>
}
else if (!_isAuthenticated)
{
    <div class="global-data-landing">
        <div class="landing-container">
            <header class="landing-header">
                <div class="header-logo" @onclick="() => _showLoginForm = false" style="cursor: pointer;">
                    <i class="fas fa-hospital-alt"></i>
                    <div class="logo-text">
                        <span class="logo-main">Rutabo Clinic</span>
                        <span class="logo-sub">ADVANCED HEALTHCARE SOLUTIONS</span>
                    </div>
                </div>
                <nav class="header-nav">
                    @if (!_showLoginForm)
                    {
                        <button class="btn btn-link" @onclick="() => { _showLoginForm = true; _showRegisterForm = false; _showForgotForm = false; }">Login</button>
                        <button class="btn btn-primary btn-round" @onclick="() => { _showLoginForm = true; _showRegisterForm = true; _showForgotForm = false; }">Register</button>
                    }
                </nav>
            </header>

            <main class="landing-main">
                @if (!_showLoginForm)
                {
                    <div class="content-left animate-in">
                        <h1 class="main-title">Hospital<br/>Dashboard</h1>
                        
                        <div class="action-pills">
                            <div class="pill @(_selectedPreview == "Hospital Overview" ? "active" : "")" @onclick="@(() => SelectPreview("Hospital Overview"))">
                                <i class="fas fa-heartbeat"></i> <span>Hospital Overview</span>
                            </div>
                            <div class="pill @(_selectedPreview == "Patient Insights" ? "active" : "")" @onclick="@(() => SelectPreview("Patient Insights"))">
                                <i class="fas fa-user"></i> <span>Patient Insights</span>
                            </div>
                            <div class="pill @(_selectedPreview == "Staff Performance" ? "active" : "")" @onclick="@(() => SelectPreview("Staff Performance"))">
                                <i class="fas fa-users"></i> <span>Staff Performance</span>
                            </div>
                            <div class="pill @(_selectedPreview == "Finance Evaluation" ? "active" : "")" @onclick="@(() => SelectPreview("Finance Evaluation"))">
                                <i class="fas fa-coins"></i> <span>Finance Evaluation</span>
                            </div>
                            <div class="pill @(_selectedPreview == "Medical Efficiency" ? "active" : "")" @onclick="@(() => SelectPreview("Medical Efficiency"))">
                                <i class="fas fa-plus-circle"></i> <span>Medical Efficiency</span>
                            </div>
                        </div>

                        <div class="action-buttons-group">
                            <button class="btn btn-primary btn-lg btn-round" @onclick="() => { _showLoginForm = true; _showRegisterForm = false; _showForgotForm = false; }">
                                <i class="fas fa-play-circle"></i> Access Portal
                            </button>
                        </div>
                    </div>
                    
                    <div class="content-right animate-in">
                        <div class="premium-card feature-preview-card" style="margin-top: 5rem;">
                            @if (_selectedPreview == "Hospital Overview")
                            {
                                <div class="preview-header mb-3">
                                    <div class="preview-icon" style="background: var(--primary-gradient)"><i class="fas fa-chart-pie"></i></div>
                                    <h3 class="preview-title">Hospital Overview</h3>
                                </div>
                                <p class="preview-desc">Explore real-time bed availability, emergency room wait times, and global clinic metrics mapped across all active departments.</p>
                                <div class="mock-stats mt-4">
                                    <div class="stat-box"><h4>@(_stats?.TotalPatients.ToString("N0") ?? "...")</h4><span>Active Patients</span></div>
                                    <div class="stat-box"><h4>@(_stats?.TotalStaff.ToString("N0") ?? "...")</h4><span>Staff on Duty</span></div>
                                </div>
                            }
                            else if (_selectedPreview == "Patient Insights")
                            {
                                <div class="preview-header mb-3">
                                    <div class="preview-icon" style="background: var(--secondary-gradient)"><i class="fas fa-procedures"></i></div>
                                    <h3 class="preview-title">Patient Insights</h3>
                                </div>
                                <p class="preview-desc">Access complete medical histories securely, track patient vitals instantly, and predict admission trends before they happen.</p>
                                <div class="mock-stats mt-4">
                                    <div class="stat-box"><h4>18m</h4><span>Avg Wait Time</span></div>
                                    <div class="stat-box"><h4>99%</h4><span>Satisfaction</span></div>
                                </div>
                            }
                            else if (_selectedPreview == "Staff Performance")
                            {
                                <div class="preview-header mb-3">
                                    <div class="preview-icon" style="background: var(--accent-gradient)"><i class="fas fa-user-md"></i></div>
                                    <h3 class="preview-title">Staff Performance</h3>
                                </div>
                                <p class="preview-desc">Monitor doctor shift reports, verify nurse availability, and streamline your workforce with automated tracking.</p>
                                <div class="mock-stats mt-4">
                                    <div class="stat-box"><h4>12</h4><span>Active Shifts</span></div>
                                    <div class="stat-box"><h4>5</h4><span>Departments</span></div>
                                </div>
                            }
                            else if (_selectedPreview == "Finance Evaluation")
                            {
                                <div class="preview-header mb-3">
                                    <div class="preview-icon" style="background: linear-gradient(135deg, #059669, #10b981)"><i class="fas fa-file-invoice-dollar"></i></div>
                                    <h3 class="preview-title">Finance Evaluation</h3>
                                </div>
                                <p class="preview-desc">Accelerate your revenue cycle management with automated hospital billing and instantaneous insurance claims processing.</p>
                                <div class="mock-stats mt-4">
                                    <div class="stat-box"><h4>$@((_stats?.ClinicRevenue ?? 42800).ToString("N1"))k</h4><span>Daily Rev</span></div>
                                    <div class="stat-box"><h4>42</h4><span>Claims Placed</span></div>
                                </div>
                                <div class="mt-4">
                                    <button class="btn btn-outline-primary btn-round w-100" @onclick='() => Navigation.NavigateTo("/billings")'>
                                        <i class="fas fa-external-link-alt mr-2"></i> Open Billing Hub
                                    </button>
                                </div>
                            }
                            else if (_selectedPreview == "Medical Efficiency")
                            {
                                <div class="preview-header mb-3">
                                    <div class="preview-icon" style="background: linear-gradient(135deg, #06b6d4, #0891b2)"><i class="fas fa-stethoscope"></i></div>
                                    <h3 class="preview-title">Medical Efficiency</h3>
                                </div>
                                <p class="preview-desc">Track essential medical equipment usage dynamically, reduce appointment bottlenecks, and drastically improve triage speed.</p>
                                <div class="mock-stats mt-4">
                                    <div class="stat-box"><h4>94%</h4><span>Resource Use</span></div>
                                    <div class="stat-box"><h4>3m</h4><span>Triage Time</span></div>
                                </div>
                                <div class="mt-4 d-flex gap-2">
                                    <button class="btn btn-outline-info btn-round flex-grow-1" @onclick='() => Navigation.NavigateTo("/inventory")'>
                                        <i class="fas fa-boxes mr-2"></i> Inventory
                                    </button>
                                    <button class="btn btn-outline-danger btn-round flex-grow-1" @onclick='() => Navigation.NavigateTo("/blood-bank")'>
                                        <i class="fas fa-tint mr-2"></i> Blood Bank
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="login-wrapper center-login animate-in">
                        <button class="btn btn-link back-btn mb-4" @onclick="() => _showLoginForm = false" style="text-align: left; padding: 0; color: white;">
                            <i class="fas fa-arrow-left"></i> Back to Home
                        </button>
                        @if (_showForgotForm)
                        {
                            <ForgotPassword OnSwitchToLogin="() => { _showForgotForm = false; _showRegisterForm = false; }" />
                        }
                        else if (_showRegisterForm)
                        {
                            <Register OnRegisterSuccess="@HandleLoginSuccess" OnSwitchToLogin="() => { _showRegisterForm = false; _showForgotForm = false; }" />
                        }
                        else
                        {
                            <Login OnLoginSuccess="@HandleLoginSuccess" OnSwitchToRegister="() => { _showRegisterForm = true; _showForgotForm = false; }" OnSwitchToForgot="() => { _showForgotForm = true; _showRegisterForm = false; }" />
                        }
                    </div>
                }
            </main>
        </div>
    </div>
}
else
{
    <div class="authenticated-layout">
        <!-- Global Unified Top Navbar -->
        <header class="dashboard-top-navbar">
            <div class="nav-brand">
                <i class="fas fa-hospital-alt logo-icon"></i>
                <span class="logo-text">Rutabo Clinic</span>
            </div>
            
            <div class="nav-user-section">
                <div class="user-info">
                    <span class="user-fullname">@_currentUser?.FullName</span>
                    <span class="user-role badge">@_currentUser?.UserType</span>
                </div>
                <button class="btn btn-logout" @onclick="HandleLogout">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </div>
        </header>

        <!-- Dynamic Role-based Dashboard -->
        <main class="dashboard-main-content">
            <DashboardContainer User="@_currentUser" />
        </main>
    </div>
}

<style>
    :root {
        --gd-primary: #ffffff;
        --gd-text: #ffffff;
        --gd-accent: #f0f0f0;
    }

    .global-data-landing {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #798bff 0%, #8c7cf0 100%);
    }

    .landing-container {
        position: relative;
        z-index: 10;
        height: 100%;
        padding: 40px 80px;
        display: flex;
        flex-direction: column;
    }

    .landing-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .header-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
    }

    .header-nav {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .header-logo i {
        font-size: 2.2rem;
    }

    .logo-text {
        display: flex;
        flex-direction: column;
    }

    .logo-main {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .logo-sub {
        font-size: 0.6rem;
        font-weight: 500;
        opacity: 0.8;
        letter-spacing: 1px;
    }

    /* Refined Buttons for Landing */
    .btn-round {
        border-radius: 100px !important;
        padding: 10px 30px !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.8rem !important;
    }

    .btn-link {
        background: transparent !important;
        border: none !important;
        color: white !important;
        font-weight: 600 !important;
        font-size: 0.9rem !important;
        padding: 0 !important;
    }

    .btn-lg {
        padding: 18px 45px !important;
        font-size: 1rem !important;
    }

    .action-buttons-group {
        margin-bottom: 3rem;
    }

    .landing-main {
        flex: 1;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .content-left {
        max-width: 600px;
    }

    .content-right {
        display: flex;
        justify-content: center;
    }

    .main-title {
        font-size: 3.5rem;
        font-weight: 700;
        color: white;
        line-height: 1.2;
        margin-bottom: 3rem;
        text-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .action-pills {
        display: grid;
        grid-template-columns: repeat(2, auto);
        gap: 15px;
        justify-content: start;
        margin-bottom: 2rem;
    }

    .pill {
        background: white;
        padding: 12px 24px;
        border-radius: 100px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #457b9d;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
        cursor: pointer;
    }

    .pill:hover {
        transform: translateY(-2px);
    }

    .pill.active {
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 4px 20px rgba(255, 255, 255, 0.4);
        transform: scale(1.05);
        color: #1e293b;
    }

    .feature-preview-card {
        width: 100%;
        max-width: 450px;
        padding: 2.5rem;
        border-radius: 20px;
    }

    .preview-header {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .preview-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.4rem;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .preview-title {
        font-weight: 800;
        color: #1e293b;
        margin: 0;
        font-size: 1.5rem;
    }

    .preview-desc {
        color: #64748b;
        line-height: 1.6;
        font-size: 1.05rem;
    }

    .mock-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        border-top: 1px solid rgba(0,0,0,0.05);
        padding-top: 1.2rem;
    }

    .stat-box h4 {
        font-weight: 800;
        font-size: 1.6rem;
        color: #1e293b;
        margin-bottom: 2px;
    }

    .stat-box span {
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .pill i {
        background: #457b9d;
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
    }

    .pill:nth-child(5) {
        grid-column: span 2;
        justify-self: center;
        margin-left: -50%;
    }

    .login-auth-section {
        margin-top: 2rem;
        max-width: 400px;
    }

    /* Hide redundant header elements in login component */
    ::deep .login-header {
        display: none !important;
    }

    /* Override Login Styles to be transparent and compact */
    ::deep .login-container {
        background: rgba(255, 255, 255, 0.15) !important;
        backdrop-filter: blur(15px) !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        box-shadow: 0 20px 40px rgba(0,0,0,0.2) !important;
        padding: 25px !important;
        color: white !important;
    }

    ::deep .login-header h2, 
    ::deep .login-header p,
    ::deep .login-form label,
    ::deep .login-footer p,
    ::deep .login-form .checkbox span,
    ::deep .login-form a {
        color: white !important;
    }

    ::deep .form-control {
        background: rgba(255, 255, 255, 0.2) !important;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
        color: white !important;
    }

    ::deep .form-control::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .center-login {
        margin: 0 auto;
        width: 100%;
        max-width: 450px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 20;
    }

    .animate-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .back-btn:hover {
        opacity: 0.8;
        text-decoration: none;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 900px) {
        .landing-container { padding: 20px; }
        .main-title { font-size: 2.5rem; }
        .action-pills { grid-template-columns: 1fr; }
        .pill:nth-child(5) { grid-column: auto; margin-left: 0; justify-self: start; }
    }
        /* Global Dashboard Navbar Styles */
        .dashboard-top-navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            padding: 1rem 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .logo-icon {
            font-size: 1.8rem;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo-text {
            font-weight: 800;
            font-size: 1.4rem;
            color: #1e293b;
            letter-spacing: -0.5px;
        }

        .nav-user-section {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-info {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .user-fullname {
            font-weight: 600;
            color: #1e293b;
        }

        .user-role {
            background: rgba(99, 102, 241, 0.1);
            color: #4f46e5;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            margin-top: 2px;
        }

        .btn-logout {
            background: #fee2e2;
            color: #ef4444;
            border: none;
            padding: 8px 16px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-logout:hover {
            background: #f87171;
            color: white;
            transform: translateY(-2px);
        }

        .dashboard-main-content {
            padding: 2rem;
            background: #f8fafc;
            min-height: calc(100vh - 75px);
        }
</style>

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated = false;
    private bool _showLoginForm = false;
    private bool _showRegisterForm = false;
    private bool _showForgotForm = false;
    private string _selectedPreview = "Hospital Overview";
    private UserModel? _currentUser;
    private DashboardStatsModel? _stats;

    private void SelectPreview(string feature)
    {
        _selectedPreview = feature;
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _isAuthenticated = await AuthService.CheckAuthenticationAsync();
        if (_isAuthenticated)
        {
            _currentUser = await AuthService.GetCurrentUserAsync();
            _stats = await DashboardService.GetDashboardStatsAsync(_currentUser?.UserType ?? "Public");
        }
        else
        {
            // For landing page previews
            _stats = await DashboardService.GetDashboardStatsAsync("Public");
        }
        _isLoading = false;
    }

    private void HandleLoginSuccess(UserModel user)
    {
        _currentUser = user;
        _isAuthenticated = true;
        _showLoginForm = false;
        _showRegisterForm = false;
        _showForgotForm = false;
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        _isAuthenticated = false;
        _currentUser = null;
        StateHasChanged();
    }
}
