@page "/login"
@layout LoginLayout
@using HospitalManagementSystem.Blazor.Services
@inject AuthService AuthService

<div class="premium-card auth-card animate-in">
    <div class="login-header text-center">
        <div class="hospital-logo">
            <i class="fas fa-hospital-alt" style="color: var(--primary-gradient)"></i>
            <h2>Routine Healthcare</h2>
        </div>
        <p>Secure Login Portal</p>
    </div>
    
    <div class="login-form mt-4">
        <div class="form-group mb-3">
            <label><i class="fas fa-user"></i> Username</label>
            <input @bind="_username" @bind:event="oninput" 
                   type="text" placeholder="Enter your username" class="form-control premium-input" />
        </div>
            
            <div class="form-group mb-4">
            <label><i class="fas fa-lock"></i> Password</label>
            <div class="password-container input-group">
                <input @bind="_password" @bind:event="oninput" 
                       type="@(_showPassword ? "text" : "password")" 
                       placeholder="Enter your password" class="form-control premium-input" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => _showPassword = !_showPassword">
                        <i class="fas fa-eye@(_showPassword ? "-slash" : "")"></i>
                    </button>
                </div>
            </div>
            
        <div class="form-options mb-3" style="display: flex; justify-content: space-between;">
            <label class="checkbox">
                <input @bind="_rememberMe" type="checkbox" />
                <span style="margin-left: 5px;">Remember me</span>
            </label>
            <a href="javascript:void(0)" @onclick="OnSwitchToForgot" style="color: #6366f1;">Forgot Password?</a>
        </div>
        
        <button class="btn btn-primary btn-block btn-login w-100 mb-3" @onclick="HandleLogin" disabled="@_isLoggingIn" style="padding: 12px; font-weight: bold; font-size: 1.1rem; border-radius: 12px;">
            @if (_isLoggingIn)
            {
                <span class="spinner-border spinner-border-sm"></span>
                <span>Logging in...</span>
            }
            else
            {
                <i class="fas fa-sign-in-alt"></i>
                <span>Login</span>
            }
        </button>
        
        <div class="login-footer text-center mt-3">
            <p>Select User Type:</p>
            <div class="user-type-buttons mb-3">
                @foreach (var userType in _userTypes)
                {
                    <button type="button" 
                            class="btn btn-sm @(userType == _selectedUserType ? "btn-primary shadow-sm" : "btn-outline-secondary")"
                            @onclick="() => _selectedUserType = userType" style="margin-right: 5px; margin-bottom: 5px;">
                        <i class="@GetUserTypeIcon(userType)"></i>
                        <span>@userType</span>
                    </button>
                }
            </div>
            <p>Don't have an account? <a href="javascript:void(0)" @onclick="OnSwitchToRegister" style="color: #6366f1; font-weight: bold;">Register Here</a></p>
        </div>
    </div>
</div>

<style>
    .auth-card {
        background: rgba(255, 255, 255, 0.95) !important;
        padding: 2.5rem !important;
    }
    .premium-input {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }
    .premium-input:focus {
        background: white;
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        outline: none;
    }
    .hospital-logo h2 {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }
</style>

@code {
    [Parameter] public EventCallback<UserModel> OnLoginSuccess { get; set; }
    [Parameter] public EventCallback OnSwitchToRegister { get; set; }
    [Parameter] public EventCallback OnSwitchToForgot { get; set; }

    private string _username = "";
    private string _password = "";
    private bool _rememberMe = false;
    private bool _showPassword = false;
    private bool _isLoggingIn = false;
    private string _selectedUserType = "Admin";
    
    private readonly List<string> _userTypes = new() { "Admin", "Doctor", "Nurse", "Reception", "Patient", "Accountant" };

    private string GetUserTypeIcon(string userType) => userType switch
    {
        "Admin" => "fas fa-user-shield",
        "Doctor" => "fas fa-user-md",
        "Nurse" => "fas fa-user-nurse",
        "Reception" => "fas fa-headset",
        "Patient" => "fas fa-user-injured",
        "Accountant" => "fas fa-calculator",
        _ => "fas fa-user"
    };

    private async Task HandleLogin()
    {
        _isLoggingIn = true;
        try
        {
            var user = await AuthService.LoginAsync(_username, _password, _selectedUserType);
            if (user != null)
            {
                await OnLoginSuccess.InvokeAsync(user);
            }
            else
            {
                // Show error (would typically use a toast service here)
                Console.WriteLine("Login failed");
            }
        }
        finally
        {
            _isLoggingIn = false;
        }
    }
}