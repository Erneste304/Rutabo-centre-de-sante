@page "/login"
@layout LoginLayout
@using HospitalManagementSystem.Blazor.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login – Rutabo Centre de Santé</PageTitle>

<div class="login-page">
    <!-- Left: Branding Panel -->
    <div class="login-branding">
        <div class="branding-inner">
            <div class="branding-logo">
                <div class="branding-icon">🏥</div>
            </div>
            <h1 class="branding-title">Rutabo Centre de Santé</h1>
            <p class="branding-subtitle">Advanced Hospital Management System</p>

            <div class="branding-features">
                <div class="feature-pill"><i class="fas fa-shield-alt"></i> Secure & HIPAA Compliant</div>
                <div class="feature-pill"><i class="fas fa-bolt"></i> Real-time Updates</div>
                <div class="feature-pill"><i class="fas fa-chart-line"></i> Analytics Dashboard</div>
            </div>

            <div class="branding-decorative">
                <div class="deco-circle deco-1"></div>
                <div class="deco-circle deco-2"></div>
                <div class="deco-circle deco-3"></div>
            </div>
        </div>
    </div>

    <!-- Right: Login Form -->
    <div class="login-form-panel">
        <div class="login-form-inner">
            <div class="login-header">
                <h2>Welcome back</h2>
                <p>Sign in to your account to continue</p>
            </div>

            @if (!string.IsNullOrEmpty(_loginError))
            {
                <div class="alert alert-danger mb-4">
                    <i class="fas fa-exclamation-circle"></i>
                    @_loginError
                </div>
            }

            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-user"></i> Username
                </label>
                <input @bind="_username" @bind:event="oninput" @onkeydown="OnKeyDown"
                       type="text" placeholder="Enter your username"
                       class="form-control login-input"
                       id="username" autocomplete="username" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-lock"></i> Password
                </label>
                <div class="password-wrapper">
                    <input @bind="_password" @bind:event="oninput" @onkeydown="OnKeyDown"
                           type="@(_showPassword ? "text" : "password")"
                           placeholder="Enter your password"
                           class="form-control login-input"
                           id="password" autocomplete="current-password" />
                    <button type="button" class="password-toggle" @onclick="() => _showPassword = !_showPassword">
                        <i class="fas fa-@(_showPassword ? "eye-slash" : "eye")"></i>
                    </button>
                </div>
            </div>

            <div class="login-options">
                <label class="checkbox-label">
                    <input @bind="_rememberMe" type="checkbox" />
                    <span>Remember me</span>
                </label>
                <a href="/forgot-password" class="forgot-link">Forgot password?</a>
            </div>

            <button class="btn btn-primary btn-login w-full" @onclick="HandleLogin" disabled="@_isLoggingIn">
                @if (_isLoggingIn)
                {
                    <span class="spinner spinner-sm"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <i class="fas fa-sign-in-alt"></i>
                    <span>Sign In</span>
                }
            </button>

            <div class="login-divider"><span>Quick Credentials</span></div>

            <div class="quick-login-grid">
                <button class="quick-btn" @onclick='() => QuickLogin("admin", "Admin@123")'>
                    <i class="fas fa-user-shield"></i> Admin
                </button>
                <button class="quick-btn" @onclick='() => QuickLogin("doctor", "Admin@123")'>
                    <i class="fas fa-user-md"></i> Doctor
                </button>
                <button class="quick-btn" @onclick='() => QuickLogin("reception", "Admin@123")'>
                    <i class="fas fa-headset"></i> Reception
                </button>
                <button class="quick-btn" @onclick='() => QuickLogin("patient", "Admin@123")'>
                    <i class="fas fa-user-injured"></i> Patient
                </button>
            </div>

            <p class="login-footer-text">
                Don't have an account? <a href="/register">Register here</a>
            </p>
        </div>
    </div>
</div>

<style>
    /* Override login layout to be full-page */
    body { overflow: hidden; }

    .login-page {
        display: flex;
        height: 100vh;
        overflow: hidden;
    }

    /* ── Left Panel ── */
    .login-branding {
        flex: 1;
        background: linear-gradient(135deg, #1a1d2e 0%, #0f3460 60%, #16213e 100%);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .branding-inner {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 40px;
        max-width: 460px;
    }

    .branding-logo {
        margin-bottom: 28px;
    }

    .branding-icon {
        font-size: 64px;
        animation: float 4s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-12px); }
    }

    .branding-title {
        font-family: 'Outfit', sans-serif;
        font-size: 2.1rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.5px;
        margin-bottom: 10px;
    }

    .branding-subtitle {
        font-size: 1rem;
        color: rgba(255,255,255,0.55);
        margin-bottom: 36px;
    }

    .branding-features {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .feature-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.8);
        padding: 8px 18px;
        border-radius: 99px;
        font-size: 0.85rem;
        font-weight: 500;
        backdrop-filter: blur(8px);
        transition: all 0.25s ease;
    }
    .feature-pill:hover {
        background: rgba(255,255,255,0.13);
        transform: scale(1.02);
    }

    /* Decorative circles */
    .branding-decorative { position: absolute; inset: 0; pointer-events: none; }
    .deco-circle {
        position: absolute;
        border-radius: 50%;
        background: rgba(67,97,238,0.12);
        border: 1px solid rgba(67,97,238,0.15);
    }
    .deco-1 { width: 350px; height: 350px; top: -100px; right: -100px; }
    .deco-2 { width: 200px; height: 200px; bottom: -60px; left: -60px; }
    .deco-3 { width: 100px; height: 100px; top: 40%; left: 10%; opacity: 0.5; }

    /* ── Right Form Panel ── */
    .login-form-panel {
        width: 480px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        overflow-y: auto;
        flex-shrink: 0;
    }

    .login-form-inner { width: 100%; max-width: 380px; }

    .login-header {
        margin-bottom: 32px;
    }
    .login-header h2 {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #1a1d2e;
    }
    .login-header p {
        font-size: 0.9rem;
        color: #5b6278;
        margin-top: 6px;
    }

    .login-input {
        padding: 12px 16px;
        border: 1.5px solid #e5e8f0;
        border-radius: 10px;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }
    .login-input:focus {
        border-color: #4361ee;
        box-shadow: 0 0 0 4px rgba(67,97,238,0.1);
    }

    .password-wrapper { position: relative; }
    .password-wrapper .login-input { padding-right: 44px; }
    .password-toggle {
        position: absolute;
        right: 12px; top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #9ba3b8;
        font-size: 14px;
        padding: 4px;
        transition: color 0.2s ease;
    }
    .password-toggle:hover { color: #4361ee; }

    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 0.855rem;
        color: #5b6278;
        cursor: pointer;
    }
    .checkbox-label input { accent-color: #4361ee; cursor: pointer; }

    .forgot-link {
        font-size: 0.855rem;
        font-weight: 600;
        color: #4361ee;
        text-decoration: none;
    }
    .forgot-link:hover { text-decoration: underline; }

    .btn-login {
        padding: 13px;
        font-size: 0.95rem;
        border-radius: 10px;
        font-weight: 700;
        justify-content: center;
        gap: 8px;
        margin-bottom: 24px;
    }

    .login-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        color: #9ba3b8;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }
    .login-divider::before, .login-divider::after {
        content: '';
        flex: 1;
        border-top: 1px solid #e5e8f0;
    }

    .quick-login-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 24px;
    }

    .quick-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 12px;
        border: 1.5px solid #e5e8f0;
        border-radius: 8px;
        background: white;
        color: #5b6278;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: 'Inter', sans-serif;
    }
    .quick-btn:hover {
        border-color: #4361ee;
        color: #4361ee;
        background: rgba(67,97,238,0.04);
    }

    .login-footer-text {
        text-align: center;
        font-size: 0.855rem;
        color: #5b6278;
    }
    .login-footer-text a { font-weight: 600; color: #4361ee; }
    .login-footer-text a:hover { text-decoration: underline; }

    /* Responsive */
    @@media (max-width: 768px) {
        .login-branding { display: none; }
        .login-form-panel { width: 100%; padding: 30px 24px; }
    }
</style>

@code {
    private string _username = "";
    private string _password = "";
    private bool _rememberMe = false;
    private bool _showPassword = false;
    private bool _isLoggingIn = false;
    private string? _loginError;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.CheckAuthenticationAsync();
        if (isAuthenticated) Navigation.NavigateTo("/dashboard");
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    private async Task HandleLogin()
    {
        _isLoggingIn = true;
        _loginError = null;
        try
        {
            var user = await AuthService.LoginAsync(_username, _password);
            if (user != null)
            {
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                _loginError = "Invalid username or password. Please try again.";
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _loginError = "Patient portal access is restricted. Please contact the health centre.";
        }
        catch (HttpRequestException)
        {
            _loginError = "Cannot reach the server. Ensure the API is running on port 5051.";
        }
        catch (Exception ex)
        {
            _loginError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoggingIn = false;
        }
    }

    private async Task QuickLogin(string username, string password)
    {
        _username = username;
        _password = password;
        await HandleLogin();
    }
}