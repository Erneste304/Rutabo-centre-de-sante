@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<AuthorizeView Roles="@RolesString">
    <Authorized>
        @ChildContent
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Access Denied</h4>
            <p>You do not have permission to access this page. Required role: @RolesString</p>
            <hr>
            <p class="mb-0"><a href="/" class="btn btn-primary">Go to Home</a></p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Roles { get; set; }

    private string RolesString => Roles ?? "";
}
