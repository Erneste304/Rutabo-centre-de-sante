@using HospitalManagementSystem.Blazor.Services
@using HospitalManagementSystem.Blazor.Models.DTOs
@inject NurseService NurseService

<div class="shift-report">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3>Create Shift Report</h3>
            <button class="btn btn-secondary btn-sm" @onclick="OnCancel">Back</button>
        </div>
        
        <div class="card-body">
            <EditForm Model="@_report" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                
                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">Shift Date *</label>
                        <InputDate class="form-control" @bind-Value="_report.ShiftDate" />
                    </div>
                    
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label">Shift Type *</label>
                        <InputSelect class="form-control" @bind-Value="_report.ShiftType">
                            <option value="Morning">Morning (7:00 AM - 3:00 PM)</option>
                            <option value="Evening">Evening (3:00 PM - 11:00 PM)</option>
                            <option value="Night">Night (11:00 PM - 7:00 AM)</option>
                        </InputSelect>
                    </div>
                </div>
                
                <div class="form-group mb-3">
                    <label class="form-label">Patients Handled *</label>
                    <InputTextArea class="form-control" rows="3" 
                                   @bind-Value="_report.PatientsHandled" />
                </div>
                
                <div class="form-group mb-3">
                    <label class="form-label">Tasks Completed</label>
                    <InputTextArea class="form-control" rows="3" 
                                   @bind-Value="_report.TasksCompleted" />
                </div>
                
                <div class="form-group mb-3">
                    <label class="form-label">Handover Notes *</label>
                    <InputTextArea class="form-control" rows="3" 
                                   @bind-Value="_report.HandoverNotes" />
                </div>
                
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-1"></i>
                            <span>Save Report</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnCancel { get; set; }
    
    private ShiftReportModel _report = new();
    private bool _isSubmitting;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        try
        {
            await NurseService.CreateShiftReportAsync(_report);
            await OnCancel.InvokeAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
