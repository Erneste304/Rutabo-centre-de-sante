@using HospitalManagementSystem.Blazor.Models.DTOs
@using HospitalManagementSystem.Blazor.Pages.Dashboard

@if (User == null)
{
    <p>Loading user data...</p>
}
else
{
    @switch (User.UserType)
    {
        case "Nurse":
            <NurseDashboard FullName="@User.FullName" Department="@(User.Department ?? "General")" />
            break;
        case "Doctor":
            <DoctorDashboard FullName="@User.FullName" />
            break;
        case "Patient":
            <PatientDashboard FullName="@User.FullName" />
            break;
        case "Admin":
            <AdminDashboard FullName="@User.FullName" />
            break;
        case "Accountant":
            <AccountantDashboard FullName="@User.FullName" />
            break;
        case "Reception":
            <ReceptionistDashboard FullName="@User.FullName" />
            break;
        default:
            <p>Unknown User Type: @User.UserType</p>
            break;
    }
}

@code {
    [Parameter] public UserModel? User { get; set; }
}
