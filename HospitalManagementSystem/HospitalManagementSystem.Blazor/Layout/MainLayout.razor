@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="app-container">
    <nav class="sidebar">
        <div class="sidebar-header">
            <h2>HMS</h2>
            <p>Hospital Management</p>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">
                    <span class="icon">📊</span>
                    <span>Dashboard</span>
                </NavLink>
            </li>

            <li class="nav-section-title">Clinical</li>
            <li class="nav-item">
                <NavLink href="/patients" class="nav-link">
                    <span class="icon">👥</span>
                    <span>Patients</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/appointments" class="nav-link">
                    <span class="icon">📅</span>
                    <span>Appointments</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/medical-records" class="nav-link">
                    <span class="icon">📋</span>
                    <span>Medical Records</span>
                </NavLink>
            </li>

            <li class="nav-section-title">Operations</li>
            <li class="nav-item">
                <NavLink href="/pharmacy" class="nav-link">
                    <span class="icon">💊</span>
                    <span>Pharmacy</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/inventory" class="nav-link">
                    <span class="icon">📦</span>
                    <span>Inventory</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/blood-bank" class="nav-link">
                    <span class="icon">🩸</span>
                    <span>Blood Bank</span>
                </NavLink>
            </li>

            <li class="nav-section-title">Management</li>
            <li class="nav-item">
                <NavLink href="/staff" class="nav-link">
                    <span class="icon">👨‍⚕️</span>
                    <span>Staff</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/rooms" class="nav-link">
                    <span class="icon">🏥</span>
                    <span>Rooms & Beds</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/billing" class="nav-link">
                    <span class="icon">💰</span>
                    <span>Billing</span>
                </NavLink>
            </li>

            <li class="nav-section-title">Emergency</li>
            <li class="nav-item">
                <NavLink href="/ambulance" class="nav-link">
                    <span class="icon">🚑</span>
                    <span>Ambulance</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink href="/emergency" class="nav-link">
                    <span class="icon">🚨</span>
                    <span>Emergency Alerts</span>
                </NavLink>
            </li>

            <li class="nav-section-title">Analytics</li>
            <li class="nav-item">
                <NavLink href="/reports" class="nav-link">
                    <span class="icon">📈</span>
                    <span>Reports</span>
                </NavLink>
            </li>
        </ul>
    </nav>

    <div class="main-content">
        <header class="top-bar">
            <div class="top-bar-left">
                <button class="menu-toggle" @onclick="ToggleSidebar">☰</button>
                <h1>Hospital Management System</h1>
            </div>
            <div class="top-bar-right">
                <div class="user-menu">
                    <span class="user-name">Welcome, User</span>
                    <button class="btn-logout" @onclick="Logout">Logout</button>
                </div>
            </div>
        </header>

        <main class="page-content">
            @Body
        </main>

        <footer class="app-footer">
            <p>&copy; 2026 Hospital Management System. All rights reserved.</p>
        </footer>
    </div>
</div>

@code {
    private bool sidebarOpen = true;

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
